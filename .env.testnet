# PUBLIC build configuration only. Never put keys, seeds or credentials here.
# The testnet release set (social v19, blog v11, storefront v12; D46), registered
# 2026-11-12 by the maker 6dV6s3a6… (nonces 1–8, heights 673312–673324).
# `npm run build` loads this file for root and for /staging (D20). See
# docs/TESTNET_DEPLOY.md and docs/TESTNET_RELEASE.md.
NEXT_PUBLIC_RELEASE=1
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_LOG_LEVEL=info

# Registered release contracts (32-byte base58 ids), all at version 1.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=3M5Dafkrnh1CaDbvF1XVvJ67xAhGQvqBiNDtNFoMVASG
NEXT_PUBLIC_YAPPR_BLOCKS_CONTRACT_ID=5DJGM1PXrP9ad5iAGExSZFL6ggqgpkgFYuUKEJfLX1NC
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=Bwr4WHCPz5rFVAD87RqTs3izo4zpzwsEdKPWUT1NS1C7
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=B99itHbjKjqms59TDU7AV5wJ7vBqLL3vup4n5XyrajEd
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=EkFqdQFuiMbxTbrokrarJb2z2U25s11BFyi1wREPCjaJ
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=E813f6SAMzvquTM9G6LFgtDJjm1h3B4V8J6qkQ2KYW7e
NEXT_PUBLIC_POLLR_CONTRACT_ID=2KweAnRxLkVTD4aMJJJSSh2UWo9kRJn7vrScLfv6gjtK
NEXT_PUBLIC_YAPPR_PASSKEY_VAULT_CONTRACT_ID=7PPZbbYbvCR3zYhwp3cnQ8pQi3YnNkwBFhYT1YFUEZsN
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v19
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v12
NEXT_PUBLIC_BLOG_TOPOLOGY=v11
NEXT_PUBLIC_POLLR_TOPOLOGY=v8
NEXT_PUBLIC_DM_TOPOLOGY=v5
NEXT_PUBLIC_PROFILE_TOPOLOGY=v2

# System contracts (DashPay v2 is the profile above), proved on testnet.
NEXT_PUBLIC_DPNS_CONTRACT_ID=GWRSAVFMjXx8HpQFaNJMqBV7MBgMK4br5UESsB4S31Ec
NEXT_PUBLIC_TOKEN_HISTORY_CONTRACT_ID=43gujrzZgXqcKBiScLa4T8XTDnRhenR9BLx8GWVHjPxF
# Maker identity, and YAPP = tokens.calculateId(social, 0). Runtime derives YAPP
# from the social id at position 0; TOKEN_ID is its release audit pin.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=6dV6s3a6Qyr6n3fn1wWmjzc3FanqhnBV2V57469MiPog
NEXT_PUBLIC_YAPP_TOKEN_ID=34xUEtfxCUjdUhvJMXnwrieoo21cHnRDYweCq7JHjNGK

NEXT_PUBLIC_LOGIN_PROTOCOL=app-connect
# Which URI the sign-in QR code carries (DIP dashpay/dips#181): dash-key
# (the default; the only one current testnet and devnet wallets accept),
# dashpay (dashpay://connect) or both (a switch on the login panel, dash-key
# first, to try old and new wallets on one staging build). Mainnet always uses
# dashpay alone, whatever this says.
NEXT_PUBLIC_APP_CONNECT_CARRIER=both
NEXT_PUBLIC_APP_CONNECT_APP_ID=8mjmcXmfLyFAX6BkawQbiuWUaNXyN3T7cSKTdTXhpDVU
NEXT_PUBLIC_APP_CONNECT_GROUP_ID=DrNB3VwKSv2zz1E7beNKFVMzyavhD2Nn1L6Lhz3K9ivR
NEXT_PUBLIC_APP_CONNECT_GROUP_OWNER=6dV6s3a6Qyr6n3fn1wWmjzc3FanqhnBV2V57469MiPog
# Anchor, social, blocks, DM v5, blog, pollr, storefront and passkey vault,
# exactly as verify-appconnect g2 proved them (32/0, 2026-11-12).
NEXT_PUBLIC_APP_CONNECT_GROUP_MEMBERS=8mjmcXmfLyFAX6BkawQbiuWUaNXyN3T7cSKTdTXhpDVU:1,3M5Dafkrnh1CaDbvF1XVvJ67xAhGQvqBiNDtNFoMVASG:1,5DJGM1PXrP9ad5iAGExSZFL6ggqgpkgFYuUKEJfLX1NC:1,B99itHbjKjqms59TDU7AV5wJ7vBqLL3vup4n5XyrajEd:1,E813f6SAMzvquTM9G6LFgtDJjm1h3B4V8J6qkQ2KYW7e:1,2KweAnRxLkVTD4aMJJJSSh2UWo9kRJn7vrScLfv6gjtK:1,EkFqdQFuiMbxTbrokrarJb2z2U25s11BFyi1wREPCjaJ:1,7PPZbbYbvCR3zYhwp3cnQ8pQi3YnNkwBFhYT1YFUEZsN:1

# D9: retired contracts MUST be explicitly blank, never inherited/defaulted.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=

# Testnet SDK uses its standard public endpoints. Blank devnet overrides.
NEXT_PUBLIC_DEVNET_NAME=
NEXT_PUBLIC_DAPI_ADDRESSES=
NEXT_PUBLIC_QUORUM_URL=
NEXT_PUBLIC_INSIGHT_API_URL=
# Store/Blog stay Beta; credit tips stay hidden (D23).
NEXT_PUBLIC_FEATURE_STORE=beta
NEXT_PUBLIC_FEATURE_BLOG=beta
NEXT_PUBLIC_FEATURE_CREDIT_TIPS=off
# Masternode voting link (EvoVote) for Moderation teams and the election banner;
# blank is https://vote.dashhq.org/. {contract} names the target contract.
NEXT_PUBLIC_MASTERNODE_VOTE_URL="https://pastapastapasta.github.io/evovote-testnet/#/m/{contract}"

# Archival ("uncensored") frontend flags (docs/ARCHIVE_FRONTEND.md). Release
# builds refuse any value here: keep both blank (the log flag may also be 0).
NEXT_PUBLIC_MODERATION_VIEW=
NEXT_PUBLIC_MODERATION_LOG=

# D21: clean start. Root scopes storage as testnet-release-2, /staging as
# testnet-release-2:staging (bumped for the 2026-11-12 set: sessions bound to
# the old App Connect group start clean). Keep stable; bump only for a reset.
STORAGE_EPOCH=testnet-release-2
# BASE_PATH, GIT_* and NEXT_PUBLIC_STORAGE_SCOPE are generated by next.config.js.
