NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=AnNHfJMavkjHK5cKj9ML2iygXKmhcGwAQpbimgrhE257
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=BRVLpWoxmbDWWdrRtSbRVPyeAVkWmpNEwt4rHpfBjYfF
