# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.
#
# SAKURA (Platform 5.0.0-beta.5, protocol 14, node network id
# dash-devnet-sakura; docs/PLATFORM_V5_BETA5_UPGRADE.md). Sakura's PLATFORM
# chain was wiped again for 5.0.0-beta.5 on 2026-10-12 (Core was kept), so
# every contract id in git history before this file is dead, as are all bonsia
# and moutai ids. Every identity was REPLAYED from its 2026-10-08 asset lock
# (a ChainLock proof of the same outpoint), so every identity id below is the
# same as on the beta.3 chain; every contract is new (docs/SAKURA_BETA5_DEPLOY.md).

NEXT_PUBLIC_NETWORK=devnet
# The SDK's devnetName is the node's network id suffix: plain `sakura`.
NEXT_PUBLIC_DEVNET_NAME=sakura

# All 13 validators, listed explicitly (seed-1..3.sakura… all resolve to one
# host). Each serves a Let's Encrypt IP-SAN certificate on :1443 (the current
# set expires 2026-10-11 and auto-renews).
NEXT_PUBLIC_DAPI_ADDRESSES=https://68.67.122.86:1443,https://68.67.122.87:1443,https://68.67.122.240:1443,https://68.67.122.241:1443,https://68.67.122.88:1443,https://68.67.122.89:1443,https://68.67.122.90:1443,https://68.67.122.91:1443,https://68.67.122.92:1443,https://68.67.122.93:1443,https://68.67.122.94:1443,https://68.67.122.95:1443,https://68.67.122.232:1443

# Quorum service for the trusted context (BLS public keys that verify read
# proofs). The SDK's name-derived default (quorums.sakura…) is the same host;
# it is set explicitly anyway.
NEXT_PUBLIC_QUORUM_URL=https://quorums.sakura.networks.dash.org

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.sakura.networks.dash.org/insight-api

# Contracts on sakura, all owned by the maker (DEVNET_MAKER_IDENTITY_ID), so
# each id is generateId(maker, nonce). The maker burned identity nonces 1-12 so
# that no new id reuses a beta.3 id and the App Connect anchor landed on the
# nonce docs/APP_CONNECT_CONTRACTS.md planned. On 2026-10-12:
#
#   nonce 13 yappr-app anchor (registers the group)  nonce 18 pollr v7
#   nonce 14 social v15                              nonce 19 storefront v8
#   nonce 15 blocks                                  nonce 20 auth vault
#   nonce 16 DM v5                                   nonce 21 key exchange (no group)
#   nonce 17 blog v8                                 nonce 22 vault (no group)
#                                                    nonce 23 key backup (no group)
#
# Nonces 13-20 were registered with scripts/register-app-connect-contracts.mjs
# from the sha256-pinned files in scripts/app-connect-set.mjs; each create
# joins the App Connect group (below), whose membership is fixed at creation.
# Key exchange, vault and key backup serve the legacy logins and are in NO
# group, so an App Connect key can never sign for them; they come from the
# pinned testnet snapshot (vault keeps requiresIdentityEncryptionBoundedKey 2).
#
# Social v15 (docs/SOCIAL_V15.md): v14 re-cut for beta.4/beta.5 with up to 8
# mentions per post or reply, reports that stay resolved, and a NON-TRANSFERABLE
# YAPP (token position 0) with baseSupply 0 whose token costs are burned.
# Identities claim the 100-YAPP once-per-identity grant; the maker mints
# anything beyond it. ELECTED moderation with the mainnet windows (7-day join,
# 3-day vote, a contestable seat with a 30-day cool-down), owner interim,
# ownerProtected: until a team is seated the maker moderates as the interim
# owner. There is NO profile contract: the base profile is DashPay's `profile`
# (system contract Bwr4WHCPz5rFVAD87RqTs3izo4zpzwsEdKPWUT1NS1C7) and the social
# `yapprProfile` type is the extension.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=BVW1hBXxLSSTo7V5ZXUf6vhJ3Zkb2CgWoCQz3fHt9t9F
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v15
# block, blockFilter and blockFollow (contracts/yappr-blocks-contract.json):
# unmoderated, read and written here on v13 and later.
NEXT_PUBLIC_YAPPR_BLOCKS_CONTRACT_ID=3QghCZZmaMtgCCvpPaspjwWr9G4fXcbXHBtfCkLQuUyx

# Optional feature contracts; their *_TOPOLOGY gates below must match. Blank an
# id to turn the feature off: services fail closed instead of querying a
# missing contract. Blog v8 and storefront v8 elect their own moderators (the
# same 7-day/3-day windows; the maker moderates as the interim owner until a
# team is seated) and charge action fees instead of YAPP.
# DM v4 is not registered on this chain (nothing to read), so it stays blank.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=9ujMJQ6NVbVyPNipviYfedqodpdgG6Jj8dTqqbUeVB69
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=AdhD9Vmu7Hn3YTGbmpFc4PeFzDtufQUZRQgxB1Y4uJt3
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=6LXB25PxQK8BewKdMrKo65oYmuBF3Gf1qxGRHXwrAZ5N
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=A4jd8chdN5AiVduWc8gBBPoi2qdKGcyS4k53JUdYCKYo
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=6u6Ztd6V64L1tn7YuCMzZntqAcv1rAFfmVWrXCN6xC3e
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=C5zxo8z6r1tpUAUaUbGWhwxDKaRcU4uwtfP4gXjh4Fjs
# Pollr v7: one ballot per voter carrying a `choices` array.
NEXT_PUBLIC_POLLR_CONTRACT_ID=4HJTBsr9fX8rxS6rGGMw4ZqsxV2MkJ46ByAADmmQ6J3i

# DM v5 (docs/DM_V5.md): unlinkable 1:1 and group messaging.
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=9z2CHrTbbkZjwVTD9WQsAGSMoHJ4zuqufNWJcH93v4Dz

# Feature topology gates, each pinned to the contract registered above.
NEXT_PUBLIC_DM_TOPOLOGY=v5
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v8
NEXT_PUBLIC_BLOG_TOPOLOGY=v8
NEXT_PUBLIC_POLLR_TOPOLOGY=v7

# App Connect (docs/APP_CONNECT_CONTRACTS.md): the yappr-app anchor (nonce 13),
# the contract group its create registered, the group's pinned owner, and the
# pinned member list (the anchor plus social v15, blocks, DM v5, blog v8,
# pollr v7, storefront v8 and auth vault). The sign-in protocol stays legacy
# (NEXT_PUBLIC_LOGIN_PROTOCOL unset) until web App Connect ships.
# A member may be pinned as `id:version`; a bare id expects version 1, and a
# member at any other version blocks App Connect logins (lib/app-connect).
# NEXT_PUBLIC_LOGIN_PROTOCOL=app-connect turns the wallet sign-in into App
# Connect (lib/app-connect/config.ts); the cut-over sets it.
# NEXT_PUBLIC_LOGIN_PROTOCOL=app-connect
NEXT_PUBLIC_APP_CONNECT_APP_ID=CWbSpGNiKGL1i3bmLSWiMQvv364FBCh8sgBqNb1Qo9N9
NEXT_PUBLIC_APP_CONNECT_GROUP_ID=3S3owNijnVrxE9FvgcHbCTG6iogKBwg69iwFhV7Pke8c
NEXT_PUBLIC_APP_CONNECT_GROUP_OWNER=9RPq2JuMsmrTUoxQLricaT245t4bYskCj4hXWcedCagH
NEXT_PUBLIC_APP_CONNECT_GROUP_MEMBERS=CWbSpGNiKGL1i3bmLSWiMQvv364FBCh8sgBqNb1Qo9N9,BVW1hBXxLSSTo7V5ZXUf6vhJ3Zkb2CgWoCQz3fHt9t9F,3QghCZZmaMtgCCvpPaspjwWr9G4fXcbXHBtfCkLQuUyx,9z2CHrTbbkZjwVTD9WQsAGSMoHJ4zuqufNWJcH93v4Dz,C5zxo8z6r1tpUAUaUbGWhwxDKaRcU4uwtfP4gXjh4Fjs,4HJTBsr9fX8rxS6rGGMw4ZqsxV2MkJ46ByAADmmQ6J3i,9ujMJQ6NVbVyPNipviYfedqodpdgG6Jj8dTqqbUeVB69,6u6Ztd6V64L1tn7YuCMzZntqAcv1rAFfmVWrXCN6xC3e

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Maker: index 9 of the privately retained deployment seed (the same key as on
# bonsia and moutai; replayed to the same id on the beta.5 chain; identity
# nonce 23 after the 2026-10-12 publish). The group id is the App Connect
# group above, kept here for humans.
# The dedicated CI seed is separate and cannot control the maker.
DEVNET_CONTRACT_GROUP_ID=3S3owNijnVrxE9FvgcHbCTG6iogKBwg69iwFhV7Pke8c
DEVNET_MAKER_IDENTITY_ID=9RPq2JuMsmrTUoxQLricaT245t4bYskCj4hXWcedCagH

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, mint) gates on it instead of the testnet authority
# baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=9RPq2JuMsmrTUoxQLricaT245t4bYskCj4hXWcedCagH

# Dedicated CI bots, in derivation-index order of the E2E_DEVNET_SEED_PHRASE
# secret: index 0 is the CI identity (yappr-ci-devnet-260915), 1-8 the DM v5
# e2e bots (yappr-dm-e2e-1..8, each with the seed-derived ENCRYPTION key). Same
# keys as on bonsia; the same ids as on the beta.3 chain, thanks to the replay.
# Testnet credentials are unchanged.
E2E_IDENTITY_IDS=AuPAmquzMYem3mxeyAaWnzpSyok9itGU8MP19GTKMBp9,Dj2D55V8R3eVkW72XpAcpZ6J3ExLpNBr2HiSHuZd7XQw,An7sPjdxSDn2DsCoyhZjxHSWbqKtFcK3uwSLh1mXDHqa,HdiuCv9qtfTWo7R4PNFEN9B3tFxYhP5X8Cbr38jKfq87,FxjY5SSmvJqCZ6zFSGWqATvNGp1czaoLATjkEF2k57Hz,9xkQEgWa2V9v9b6Ujb9v3uJfLwVh2SXofFNXapRE64CF,7mXLFFbjNSVWyY5m8i4R5LPHhwKW7dF8vh9gNvLpGLCG,CB6dvhWfhn61Vfw17axv3AougXnMGt3oxFw8yi9DsRoc,B6Hpa1MJ3JqzA1MS38tnhRf9pBmUp4Cvkznx89NWsWEL

NEXT_PUBLIC_LOG_LEVEL=debug
