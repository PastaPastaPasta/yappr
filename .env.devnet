# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_DEVNET_NAME=moutai

# moutai has no masternode discovery, so the DAPI pool is listed explicitly.
# Five seed hostnames round-robin over three machines; only :1443 is open, and it
# serves a valid public TLS certificate.
NEXT_PUBLIC_DAPI_ADDRESSES=https://seed-1.moutai.networks.dash.org:1443,https://seed-2.moutai.networks.dash.org:1443,https://seed-3.moutai.networks.dash.org:1443,https://seed-4.moutai.networks.dash.org:1443,https://seed-5.moutai.networks.dash.org:1443

# Quorum service for the trusted context (BLS public keys used to verify read
# proofs). REQUIRED — without it every read fails: wasm-sdk 4.2.0-dev.2 panics on
# `proofs: false` ("queries without proofs are not supported yet") and refuses
# non-trusted proof verification ("Non-trusted mode is not supported in WASM").
# The SDK's default host, quorums.moutai.networks.dash.org, is live (stood up
# 2026-08-27, ELB), so the name-derived default works and this override is only
# needed if the service moves. First hits after idle can take ~10s (cold start);
# scripts warm the endpoints with a curl before connecting.
# NEXT_PUBLIC_QUORUM_URL=

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.moutai.networks.dash.org/insight-api

# Contracts on moutai. Published by:
#   NETWORK=devnet node scripts/register-test-contracts.mjs \
#     --source-network testnet \
#     --from-social 9oDC6xdg8WRixTD2j3FCBq3vtsrf6bRGjXSJbhtFoma9 \
#     --from-profile FZSnZdKsLAuWxE7iZJq12eEz6xfGTgKPxK7uZJapTQxe \
#     --owner <devnetMakerId> --owner-index 9
# followed by scripts/set-yapp-price.mjs to set the YAPP direct-purchase price
# (1,000,000 credits per token, minimum 100 per purchase).
#
# The social contract is the V3 INTERACTION TOPOLOGY
# (contracts/yappr-social-contract-v3-topology.json): flat threads
# (reply.rootPostId + replyToReplyId), a separate likeReply doctype, posts-only
# repost/bookmark, dual quote fields, and permanent post/reply documents
# (canBeDeleted:false, documentsMutable:true) — every identifier field
# refersTo-checked. Registered 2026-08-27 via
#   NETWORK=devnet node scripts/register-social-v3-draft.mjs \
#     --contract-file contracts/yappr-social-contract-v3-topology.json
# and verified with scripts/verify-topology.mjs (31/31 checks).
#
# It SUPERSEDES the v3-draft contract 3414JJ3xGXK3Cgpy7NAdDXwAjvyoeD4bcBTX6nSh7ysg
# (v2 schemas plus two identity refersTo declarations), which is left on chain but
# no longer served. The contract id and NEXT_PUBLIC_CONTRACT_TOPOLOGY below must
# always be flipped together: pointing a v2 client at this contract, or a v3
# client at a v2 contract, produces queries against doctypes and fields that do
# not exist. Profile contract cloned from testnet.
# 4UW9im1y… is the topology contract with the OWNER-FIRST like/likeReply unique
# indexes (ownerAndPost / ownerAndReply) — batched liked-state membership works
# in one query. Every devnet contract is deliberately registered on a
# never-before-used id: contract ids are hash(owner, nonce), the 2026-08-28 wipe
# replays the maker's nonce sequence, and any pre-wipe id would otherwise
# reattach to a DIFFERENT contract (poisoning any client that cached schemas by
# contract id).
#
# Registered 2026-08-29, superseding 12ESJNxm…: post/reply.mediaUrl is relaxed
# to `^(https?|ipfs)://.+$` so image attachments are stored natively as
# ipfs://CID. 12ESJNxm… was registered from the https-only file, and
# dataContractUpdate cannot change an existing property's pattern, so the
# ipfs:// support required this fresh registration rather than an update.
# YAPP token 3oG4Y2CLftptk73oFGoxdvWUwouP71KNBNZW1obCW2qA (bots funded 1000 each,
# direct-purchase price set).
# v4 CUTOVER 2026-08-29: Aux325if… is the contract-v4 DRAFT (indexOnly likes,
# single hashtag with the '' stand-in, author agreements) — verify-v4.mjs 68/68.
# It supersedes 4UW9im1y… (v3 + ipfs mediaUrl), left on chain unused. A final v4
# re-registration happens when the upstream null-skip release lands (hashtag
# flips optional); until then this draft is the QA target.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=Aux325ifCRkYUteevirCv7ptHm3YB2g7PbMo8UjQwoz
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v4
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=6L6qmKAx57xcjkYARqWag9SNYhbBHb8A1WNWagPtU6YW

# Optional feature contracts, cloned from their testnet copies' on-chain schemas
# and published under the devnet maker, re-registered 2026-08-28 after the
# moutai wipe via
#   NETWORK=devnet node scripts/register-feature-contracts.mjs
# (pollr included — the testnet original is externally owned, but the devnet
# clone is maker-owned like everything else). Blank an id to turn the feature
# off: services fail closed (report unconfigured / preload skips them) instead
# of querying ids that do not exist on this chain.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=DNNibJtgEEkQkLfDZXh9xkbfdVHWu6CtJcgcpicMAuHZ
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=GVSCnyrb3Hfth8T9B6PcxK7NCMJnH4Q9VKZReY3ANZRe
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=ABzVw5Fj6ccLJp8bzA9ro6pkBeZZaEbucFxoLdeNudr6
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=BoRY8pEw7U2Ft3P2gcVPZGDvR7MfCZV3Z1mXmuHpu6ZQ
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=DMktR8HRdorTz4zo3aMeN4zAR2LKp43cDor8RWrLpUsU
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=A6x2T19Wh8Ps5D32XiWYhnk4hBgnA85wKrhtW6Y6NDZ6
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=4ZxGLZw4erinvft6zpiGZzh16hiKDX1ewEV1E3wk2UeK
NEXT_PUBLIC_POLLR_CONTRACT_ID=HhKqccdmZjy9iA537QvoAEvW3YLToqiney4fKe2vLW71

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Contract-maker identity: seed index 9, so it is recoverable from E2E_SEED_PHRASE
# alone (unlike testnet's maker, whose key lives in a ~/Downloads JSON).
DEVNET_MAKER_IDENTITY_ID=DuqE3zgXprS5zU51YaB4GuGxTRzzukW59XAYKeM6gKGA

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, price changes) gates on it instead of the testnet
# authority baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=DuqE3zgXprS5zU51YaB4GuGxTRzzukW59XAYKeM6gKGA

# Comma-separated identity IDs of the devnet bot pool, in derivation-index order
# (seed indices 0 and 1). Identity IDs come from the asset-lock outpoint, so a
# devnet bot has a different id than its testnet counterpart at the same index.
E2E_IDENTITY_IDS=EEKarQ4hK3eiBGWNp1j11L7DMfdyFD6zfqaUktj81ikD,3NdmhtrNQA83jfUMTotE2pZyxSoYd1JxYqabNFdNRwGu

NEXT_PUBLIC_LOG_LEVEL=debug
