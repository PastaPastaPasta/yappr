# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_DEVNET_NAME=moutai

# moutai has no masternode discovery, so the DAPI pool is listed explicitly.
# Five seed hostnames round-robin over three machines; only :1443 is open, and it
# serves a valid public TLS certificate.
NEXT_PUBLIC_DAPI_ADDRESSES=https://seed-1.moutai.networks.dash.org:1443,https://seed-2.moutai.networks.dash.org:1443,https://seed-3.moutai.networks.dash.org:1443,https://seed-4.moutai.networks.dash.org:1443,https://seed-5.moutai.networks.dash.org:1443

# Quorum service for the trusted context (BLS public keys used to verify read
# proofs). REQUIRED — without it every read fails: wasm-sdk 4.2.0-dev.2 panics on
# `proofs: false` ("queries without proofs are not supported yet") and refuses
# non-trusted proof verification ("Non-trusted mode is not supported in WASM").
# The SDK's default host, quorums.moutai.networks.dash.org, is live (stood up
# 2026-08-27, ELB), so the name-derived default works and this override is only
# needed if the service moves. First hits after idle can take ~10s (cold start);
# scripts warm the endpoints with a curl before connecting.
# NEXT_PUBLIC_QUORUM_URL=

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.moutai.networks.dash.org/insight-api

# Contracts on moutai — V5 CUTOVER, registered 2026-08-31 after the platform-only
# wipe + upgrade to 4.2.0-dev.7 (PV14; core chain persisted, identities restored
# with their ORIGINAL ids from the recorded asset-lock outpoints). Published per
# docs/DEPLOY_V5_RUNBOOK.md:
#   NETWORK=devnet node scripts/register-social-v3-draft.mjs --bot 9 \
#     --owner <devnetMakerId> \
#     --contract-file contracts/yappr-social-contract-v5.json --fund <bot0>,<bot1>
#   NETWORK=devnet node scripts/register-test-contracts.mjs --source-network testnet \
#     --from-profile FZSnZdKsLAuWxE7iZJq12eEz6xfGTgKPxK7uZJapTQxe \
#     --only profile --owner <devnetMakerId> --owner-index 9
#   NETWORK=devnet node scripts/register-feature-contracts.mjs \
#     --owner <devnetMakerId> --owner-index 9
# followed by scripts/set-yapp-price.mjs (1,000,000 credits per token, minimum
# 100 per purchase). YAPP token 4oGisobdfoueLKBUvekqeXR2JJgqbPfRurUdhkSM5Zjj
# (bots funded 2000 each, personas 600 each, direct-purchase price set).
#
# The social contract is CONTRACT V5 (contracts/yappr-social-contract-v5.json,
# built by scripts/build-v5-contract.py): the v4 interaction topology with
# `hashtag` OPTIONAL on post/like (61-char ceiling, the '' sentinel dies),
# skipIfAbsent byHashtagPost, rankedCountable at-forms ({at:"hashtag"} trending,
# {at:["postAuthor","postId"]} creator leaderboard + per-author Top), a PLAIN
# byAuthorTimePost sibling (#4543 count-exempt admission), and the upgraded
# follow rankings. verify-v5.mjs: ALL 91 CHECKS PASSED live (a1-a6, b1-b12,
# c1-c5) on 2026-08-31. The contract id and NEXT_PUBLIC_CONTRACT_TOPOLOGY below
# must always be flipped together: a v4 client pointed at the v5 contract
# writes `hashtag: ''`, which v5 REJECTS.
#
# RECYCLED IDS, ON PURPOSE THIS TIME: contract id = hash(owner, nonce), the
# wipe replays the maker's nonce sequence, and this cut knowingly landed on
# first-era (2026-08-27/28) ids — every id below was verified by reading the
# registered contract back and checking its doctypes. The mapping MOVED across
# families, so never trust any pre-2026-08-31 note about what an id means:
#   3414JJ3x… was the v3-DRAFT SOCIAL      → ABANDONED first v5 cut (its
#     byHashtagPost carried only {at: "hashtag"}, which live calibration showed
#     cannot serve the per-tag Top ranking; superseded within the hour)
#   BQrC6mu3… (fresh id, next owner nonce)  → the V5 SOCIAL contract
#     (byHashtagPost re-cut to {at: ["hashtag", "postId"]} — both levels)
#   DR5sJcSM… was the first profile        → now the profile contract (same family)
#   GwGV4Gkb… was the v3-TOPOLOGY SOCIAL   → now the DM contract
#   9Mrjgs33… was the like-reversal SOCIAL → now the STOREFRONT contract
#   8oKFYZUd… was the DM contract          → now the KEY-BACKUP contract
#   H25GMYVz… was the storefront           → now the KEY-EXCHANGE contract
#   6Qgy1hpZ… was the key backup           → now the VAULT contract
#   GY6n4PoB… was the key exchange         → now the AUTH-VAULT contract
#   4CD14N3r… was the vault                → now the BLOG contract
#   AtEKZmw9… was the auth vault           → now the POLLR contract
# Superseded second-era (2026-08-28/29) ids, all left on the PREVIOUS platform
# state and gone from this chain — they feed the next wipe's collision list:
# social Aux325if… (v4 draft, verify-v4 68/68) > 4UW9im1y… (v3 + ipfs mediaUrl)
# > 12ESJNxm… (https-only mediaUrl); profile 6L6qmKAx…; DM DNNibJtg…;
# storefront GVSCnyrb…; keyBackup ABzVw5Fj…; keyExchange BoRY8pEw…; vault
# DMktR8HR…; authVault A6x2T19W…; blog 4ZxGLZw4…; pollr HhKqccdm…; YAPP token
# 3oG4Y2CL….
NEXT_PUBLIC_YAPPR_CONTRACT_ID=BQrC6mu3Ew3a46PcQuAn8GHMmwEXaLvoCfRBuweaEX8Y
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v5
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=DR5sJcSMj3jK9z32B7jRR62xmiHj7MdWym65NF4MoJp8

# Optional feature contracts, cloned from their testnet copies' on-chain schemas
# and published under the devnet maker, re-registered 2026-08-31 after the
# moutai wipe via
#   NETWORK=devnet node scripts/register-feature-contracts.mjs
# (pollr included — the testnet original is externally owned, but the devnet
# clone is maker-owned like everything else). Blank an id to turn the feature
# off: services fail closed (report unconfigured / preload skips them) instead
# of querying ids that do not exist on this chain.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=GwGV4Gkb5Vb6VE2m45DnSpKQEha41amSxiopK9eo9WnG
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=9Mrjgs33AYDYuLbCAsK5jUTEQTJVep8Ytwpdf5Ka5F6E
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=8oKFYZUdSH5RRoYMBt9s1WaVn4mETjUGWeA2QRTAB1Ms
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=H25GMYVzAN2YKooWeTdLbtx6E8Lzq5zprzMty9Xwn8jT
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=6Qgy1hpZUPTYUSVcLmRb1rVTzfMN8EPUnbrDEYyDHsuV
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=GY6n4PoBWUMoSfDQfH6CoQCFUgCPvXZmAauiqBTr6vS4
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=4CD14N3rZbdRYtRvnyjYJfnteTeJpt8vLGcib6T5MRiB
NEXT_PUBLIC_POLLR_CONTRACT_ID=AtEKZmw9vVniz89VtuLRQXT4Yjrpxd4MRjRfKugExenD

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Contract-maker identity: seed index 9, so it is recoverable from E2E_SEED_PHRASE
# alone (unlike testnet's maker, whose key lives in a ~/Downloads JSON).
DEVNET_MAKER_IDENTITY_ID=DuqE3zgXprS5zU51YaB4GuGxTRzzukW59XAYKeM6gKGA

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, price changes) gates on it instead of the testnet
# authority baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=DuqE3zgXprS5zU51YaB4GuGxTRzzukW59XAYKeM6gKGA

# Comma-separated identity IDs of the devnet bot pool, in derivation-index order
# (seed indices 0 and 1). Identity IDs come from the asset-lock outpoint, so a
# devnet bot has a different id than its testnet counterpart at the same index —
# and the same id across wipes while the core chain (and thus the outpoint)
# persists, which is how the 2026-08-31 restoration kept these unchanged.
E2E_IDENTITY_IDS=EEKarQ4hK3eiBGWNp1j11L7DMfdyFD6zfqaUktj81ikD,3NdmhtrNQA83jfUMTotE2pZyxSoYd1JxYqabNFdNRwGu

NEXT_PUBLIC_LOG_LEVEL=debug
