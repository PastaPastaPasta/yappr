# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_DEVNET_NAME=moutai

# moutai has no masternode discovery, so the DAPI pool is listed explicitly.
# Five seed hostnames round-robin over three machines; only :1443 is open, and it
# serves a valid public TLS certificate.
NEXT_PUBLIC_DAPI_ADDRESSES=https://seed-1.moutai.networks.dash.org:1443,https://seed-2.moutai.networks.dash.org:1443,https://seed-3.moutai.networks.dash.org:1443,https://seed-4.moutai.networks.dash.org:1443,https://seed-5.moutai.networks.dash.org:1443

# Quorum service for the trusted context (BLS public keys used to verify read
# proofs). REQUIRED — without it every read fails: wasm-sdk 4.2.0-dev.2 panics on
# `proofs: false` ("queries without proofs are not supported yet") and refuses
# non-trusted proof verification ("Non-trusted mode is not supported in WASM").
# The SDK's default host, quorums.moutai.networks.dash.org, is live (stood up
# 2026-08-27, ELB), so the name-derived default works and this override is only
# needed if the service moves. First hits after idle can take ~10s (cold start);
# scripts warm the endpoints with a curl before connecting.
# NEXT_PUBLIC_QUORUM_URL=

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.moutai.networks.dash.org/insight-api

# Contracts on moutai (Platform 4.2.0-beta.6 / protocol 14). Superseded
# deployment IDs remain in git history.
#
# DEPLOYED 2026-09-28. The Platform state was wiped for 4.2.0-beta.6; the Core
# chain persisted, so all 162 identities were restored from their retained
# asset locks and kept their original ids. All eleven contracts below are
# maker-owned and enrolled in ONE contract group,
# 1zMU1c6bsK4dcGEUmeZLiKB94a9emK61hHdzoLAsdJ4 (DEVNET_CONTRACT_GROUP_ID
# below), registered on a social create at maker nonce 54. The ids and the
# topology flags move in this ONE commit: deploy.yml rebuilds /devnet from this
# file on every push to staging, and a mismatched client against a contract
# fails totally rather than degrading.
#
# Social v9 = v8 plus ELECTED moderation (a charter team is seated through a
# masternode-voted contest; the owner moderates in the interim and is
# protected from the seated team), a warning list, distinctFrom gates,
# private-feed gates and typed arrays (docs/SOCIAL_V9.md), plus the beta.5
# propertyConstraints rules (docs/CONTRACTS_BETA5.md). The beta.6 re-cut
# (docs/CONTRACTS_BETA6.md) adds the `report` type (moderators dismiss a report
# by deleting it; reports expire after 90 days via ttl), the replyDeletedCount
# count index, and 3600 s election join/vote windows. Blog v5 adds the
# commentsOpen rule and an owner gate (NEXT_PUBLIC_BLOG_TOPOLOGY=v5 below).
#
# Contract ids are generateId(owner, nonce). Maker identity nonces 1-53 (every
# beta.1-beta.5 id) were burned before publication. Nonces 54-64 published the
# unchanged beta.5 set first (and registered the group); the beta.6 re-cut then
# published only what changed: social @65, storefront @66 (it embeds the social
# id) and blog @67. Profile, key backup, key exchange, vault, auth vault, DM v4,
# pollr and DM v5 are byte-identical to the re-cut files and keep their @55-64
# ids. The YAPP token (social position 0) is
# 5Xr5PXgZbmbPvpzK1kv43DLc2SCaQMipEo57QA7WJUDz, priced at 1,000,000 credits.
#
# DO NOT REUSE these superseded ids — each is bound to a DIFFERENT schema:
#   social v9     6tpg2F1GUo7XpyGiZtNwfgwnMnyjCqR4T7VUVKXcRQSq  (beta.6 @54, pre-re-cut)
#   storefront v4 Cp7tWGxoxXEC1c5F9LEA9zY9AEiHjSZLSyvDcgNoWP47  (beta.6 @60, old social id)
#   blog v4       6UqwQwTaGW66KUiWFHmEH4CCMSCiT5Cbuim1TqEyJwP5  (beta.6 @61)
#   social v9     HCAoKyuAbQ63cg6LU44F1Wz2wwqBR2iFybwJk58G9dsa  (beta.5, wiped)
#   (these three beta.6 ids stay listed in the group; memberships cannot be
#   removed. Full blocklist: the ops fresh-id-check)
NEXT_PUBLIC_YAPPR_CONTRACT_ID=GZvtZ81GRk27w4UeNjpzrutVaD42JhoGm2QGMr1y9x8g
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v9
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=Fg4QVgBuBeZhKofudBaM8nb1gmMvqSqe533jMuAjSpRV

# Optional feature contracts. DM v4 (legacy threads for the v5 client),
# storefront v4, blog v5 and Pollr v4 are maker-owned and in the same contract
# group as social; their *_TOPOLOGY gates below must match. Key backup,
# key exchange, vault and auth vault remain the testnet-cloned schemas.
# Blank an id to turn the feature off: services fail closed (report
# unconfigured / preload skips them) instead of querying a missing contract.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=6PM3S3QzHrBUzX6CGEDcSCo1iXKf9tWMuPBaeJuBGaYr
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=BcTTzjvxU6ZCKCQx73kPToZ1kjr6npykfT2CiCbThstU
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=72e5maV6RhsrPNYo66UUmnGoTGBTVnxXTBTQte3XQC45
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=98Wy1tjrWRKsKjzdB1TbzZuDdiFLe4rQ6cveUtskAqtW
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=CFEjAedNgzwELFFR5c2yNDhEaECGDSi6BqoShNhHcc3V
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=4UU554EywCJGCSxC52vBfNnwaKbAm2NroyDFxcyZuVDZ
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=4WF23ko6ktLbp5zJgFcPnevawnCiHCCvGHSsQ5vjmpnL
NEXT_PUBLIC_POLLR_CONTRACT_ID=YYbqLuAii3P9k4LKHnajzURJwHjqfN6pCnjRXXqKQUH

# DM v5 (docs/DM_V5.md): unlinkable 1:1 and group messaging. Published
# 2026-09-28 by the maker at identity nonce 64 from
# contracts/yappr-dm-contract-v5.json, in the contract group.
# NEXT_PUBLIC_DM_TOPOLOGY=v5 below sends every new
# conversation here; NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID above stays the DM v4
# contract, now read-only: its threads are merged into the v5 timeline (§10)
# and nothing new is written to it. Proved end to end by e2e/write/dm-v5-*.
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=CxMs5sCt6xALPjWgTGwYFaMmR1MzrEBqq5qiUNqdab3r

# Feature topology gates, each pinned to the contract registered above. The
# readers live on the unmerged non-social branch, so staging's lib/constants.ts
# may still ignore them; they are set now so the flag and the id never drift.
NEXT_PUBLIC_DM_TOPOLOGY=v5
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v4
NEXT_PUBLIC_BLOG_TOPOLOGY=v5
NEXT_PUBLIC_PROFILE_TOPOLOGY=v2
NEXT_PUBLIC_POLLR_TOPOLOGY=v4

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Maker: index 9 of the privately retained deployment seed. Restored on
# 2026-09-18 with its original id from its retained Core asset lock.
# The dedicated CI seed is separate and cannot control the maker.
DEVNET_CONTRACT_GROUP_ID=1zMU1c6bsK4dcGEUmeZLiKB94a9emK61hHdzoLAsdJ4
DEVNET_MAKER_IDENTITY_ID=3JKc6iVG74LEMSrAtB4VSHPQW2mtgKAw8s3Ki6tTFcRQ

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, price changes) gates on it instead of the testnet
# authority baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=3JKc6iVG74LEMSrAtB4VSHPQW2mtgKAw8s3Ki6tTFcRQ

# Dedicated CI bots, in derivation-index order of the E2E_DEVNET_SEED_PHRASE
# secret. Index 0 was restored from its saved Core asset lock; indices 1-4 were
# registered 2026-09-23 for the DM v5 specs, 5-8 the same day (the specs use 1-8;
# each identity carries the seed-derived ENCRYPTION key and a yappr-dm-e2e-<n>
# DPNS name). Testnet credentials are unchanged.
E2E_IDENTITY_IDS=EShbqnfLdmctGWaUCnU3FNKMenYmxiQEiawY3q2pLQm2,81CQGtrWH6Ya3pZ5rxbsvy9Zc6Lt9DzzddV4nFrNEzhp,2wZTPNQqt6fpTHa2nwTLKXKk285XgWxvpFjMLU49fNvx,9KSJKU3epr7LKMNTCpFwMhMAuSQmn852NgP9aY4hYTVn,2TaMxdgxkQQdAMwxq3UWeiTvxZnKAJAW9fybmwPaHART,86dNvmDQqBaMfZw69oyd6AquP7mJEGWrYBth24v35vKJ,8Xi6rYVH6jiXZz58zHddgcJe4dMyg8D546rqZ1SzYvm5,HrrWGNophXQPzxo4xcFPgNuhjPfQgtkqS5xaBZWuUjg8,Cvdqdm46UsEsNxhJCSqATdthTjdLc9QuXGBfMmqVhHdj

