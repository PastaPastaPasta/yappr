# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.
#
# BONSIA (Platform 4.2.0-beta.7, protocol 14, node network id
# dash-devnet-bonsia-g1). moutai is RETIRED (2026-09-29); every moutai id in git
# history is dead. Bonsia is a fresh chain, Core included, so nothing was
# restored: every identity was re-created from a new asset lock with the SAME
# keys (new ids), and every contract below is new.

NEXT_PUBLIC_NETWORK=devnet
# The SDK's devnetName must be the node's network id suffix: plain `bonsia`
# fails with MalformedResponse.
NEXT_PUBLIC_DEVNET_NAME=bonsia-g1

# bonsia has no seed DNS and no masternode discovery: all 13 evonodes are listed
# explicitly. Each serves a Let's Encrypt IP-SAN certificate on :1443.
NEXT_PUBLIC_DAPI_ADDRESSES=https://68.67.122.224:1443,https://68.67.122.225:1443,https://68.67.122.226:1443,https://68.67.122.227:1443,https://68.67.122.228:1443,https://68.67.122.229:1443,https://68.67.122.230:1443,https://68.67.122.242:1443,https://68.67.122.243:1443,https://68.67.122.244:1443,https://68.67.122.245:1443,https://68.67.122.246:1443,https://68.67.122.247:1443

# Quorum service for the trusted context (BLS public keys that verify read
# proofs). REQUIRED and explicit: the SDK's name-derived default would be
# quorums.bonsia-g1.networks.dash.org, which does not exist.
NEXT_PUBLIC_QUORUM_URL=https://quorums.bonsia.networks.dash.org

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.bonsia.networks.dash.org/insight-api

# Contracts on bonsia, published 2026-09-29 by the maker (a new identity on a
# fresh chain, so contract ids are generateId(maker, nonce) with nothing to
# burn). All ten live contracts are maker-owned and enrolled in ONE contract
# group, 2KGtNcbC3K29XbzLaoXyyUgVwtWxp25LX8HUBKiCmNVy (DEVNET_CONTRACT_GROUP_ID
# below), registered on the first social create at nonce 1. Sources:
# beta7/contracts-v10 6be0164a, sha256-pinned (docs/SOCIAL_V10.md); key backup,
# key exchange, vault and auth vault from the testnet snapshot.
#
#   nonce 2  key backup       nonce 8  DM v4
#   nonce 3  key exchange     nonce 9  pollr v4
#   nonce 4  vault            nonce 10 DM v5
#   nonce 5  auth vault       nonce 11 (a credit transfer, no contract)
#                             nonce 12 social v10 (rolling like windows)
#                             nonce 13 storefront v5 (embeds the social id)
#                             nonce 14 blog v5 (embeds the social id)
#
# The same day social was re-cut for rolling trending windows on `like`
# (byTrendPost 72h/24h, byTrendHashtagPost 24h/6h), so social, storefront and
# blog were republished at nonces 12-14 into the same group. DO NOT REUSE the
# superseded ids below; each is bound to a different schema, and they stay
# listed in the group because memberships cannot be removed:
#   social v10    6aEp57jsrpgUeYgRyTVJ46DpKrgwhaqfY1gpe9D6E3Au  (nonce 1, daily windows)
#   storefront v5 8qWVsa5Ydu3gsQbTnkkAEsZJVvmMc1yQNAyNqEA2o7gw  (nonce 6, old social id)
#   blog v5       6j8wA3xa1vQmdgBRpJDQAs2Wc7BoPMfjbfaPMF5uCLE4  (nonce 7, old social id)
#
# Social v10 (docs/SOCIAL_V10.md): real deletes (no tombstones), 1000-character
# posts, media hashes, keyGeneration, no `beat` (trending reads like), reports
# resolved by changeDocumentFields, ELECTED moderation with 3600 s join/vote
# windows (owner interim, ownerProtected). There is NO profile contract on v10:
# the base profile is DashPay's `profile` (system contract
# Bwr4WHCPz5rFVAD87RqTs3izo4zpzwsEdKPWUT1NS1C7) and the social `yapprProfile`
# type is the extension, so NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID and
# NEXT_PUBLIC_PROFILE_TOPOLOGY are gone.
#
# YAPP (social token position 0) is FHtkmv5esJqxCf8sb4xKmd4Eb8D15KgYQnKuVG2bvNoi.
# It starts paused and can never be unpaused or priced: transfers are refused
# (40711) and direct purchases are refused (40721). Identities claim the
# 100-YAPP once-per-identity grant; the maker mints anything beyond it.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=FbgmcQbAUdEKCYrAkXJENTToBbPEjoMirtF5gAtcCiA2
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v10

# Optional feature contracts, maker-owned and in the same group as social;
# their *_TOPOLOGY gates below must match. Blank an id to turn the feature off:
# services fail closed instead of querying a missing contract.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=Dr8VrDNgiKpw61YkD2UfyRD6x1khETab5Tru8HxGWyVt
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=J4d8MZSXW6ezLqki9z8pVpZnyNXPTZY6zMmH63aEZc6L
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=CNvs43c1s6B81MYEWJW8mnaCZaAXzekB1AyebuBTWJgy
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=9UgRuCx9zKrpmCAGkr4QV5i8PViWABw28t7wCqHeap89
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=F5JdM5agRXgx4wCE6vXgfXuu665QmnSFuJSpKVb8iuMa
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=DvWJ7n5znm3qiBPgZqxrPCPpp963KLqeNDcxN61jxn5z
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=FJ2AiWmsV2yuJt2L3zNgVx6feAiTk9uPgfyctqnVVdA3
NEXT_PUBLIC_POLLR_CONTRACT_ID=4PFtwCkBZQMvEJATFEaEp7xhotd78uCoPd1tw98fNX9G

# DM v5 (docs/DM_V5.md): unlinkable 1:1 and group messaging. Every new
# conversation goes here; the DM v4 contract above is read-only and its threads
# merge into the v5 timeline.
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=2hiqX8Xzi57PCMTs7oRgkip556qWfqQj5TRaeVrouzrF

# Feature topology gates, each pinned to the contract registered above.
NEXT_PUBLIC_DM_TOPOLOGY=v5
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v5
NEXT_PUBLIC_BLOG_TOPOLOGY=v5
NEXT_PUBLIC_POLLR_TOPOLOGY=v4

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Maker: index 9 of the privately retained deployment seed (the same key as on
# moutai, a new identity id on bonsia). Identity nonce 14 after the re-cut.
# The dedicated CI seed is separate and cannot control the maker.
DEVNET_CONTRACT_GROUP_ID=2KGtNcbC3K29XbzLaoXyyUgVwtWxp25LX8HUBKiCmNVy
DEVNET_MAKER_IDENTITY_ID=7SsQvk6U74bMU3FSjsXpyfhntzTyogheMRDECppsQX3o

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, mint) gates on it instead of the testnet authority
# baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=7SsQvk6U74bMU3FSjsXpyfhntzTyogheMRDECppsQX3o

# Dedicated CI bots, in derivation-index order of the E2E_DEVNET_SEED_PHRASE
# secret: index 0 is the CI identity (yappr-ci-devnet-260915), 1-8 the DM v5
# e2e bots (yappr-dm-e2e-1..8, each with the seed-derived ENCRYPTION key). Same
# keys as on moutai, new ids on bonsia. Testnet credentials are unchanged.
E2E_IDENTITY_IDS=3NRt6KPQoy8mkrrRch4ujTdreAQNQjMuBq7FyyriaN6W,5TeySquE2p9Mc34doJZ1DLeyJSBEe5ybZxDzAXt5snm3,H5U8JyohFAZqfrtQNp9YBKH7BhKwdF27CRpbsA6YrMGB,FRZ61BmdLN5wMPp8BXGb26YmTtPa5PU3D2AagQEfcYp1,6rzdCfCpdGfga5RLigDVa2eBVwWFDfPCsUpE7o4wEgft,Avdob53Q3bMbHeJgKQaEKNZadrmTUxDnaQ1g5FVccHS7,DHeh3y137vWsscju1tVswg8KH9VjtMGg67gtVSKAvGq4,FpwxctyK1GuF8YKPiNHg4rs1CZeejJ3UUdurrWzAr2w4,84BbgfU1bvRNrg4ugvwXPVaigCxpYkTciUftD9sDZGPK

NEXT_PUBLIC_LOG_LEVEL=debug
