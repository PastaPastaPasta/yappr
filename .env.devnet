# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.
#
# SAKURA: dash-devnet-sakura, protocol 14. The release rehearsal registered
# this set on 2026-10-18 without a chain reset. See docs/SAKURA_RELEASE_REHEARSAL.md.
# Identity ids survived the earlier beta.6 Platform reset through asset-lock
# replay; this deployment uses fresh contracts and a fresh App Connect group.

NEXT_PUBLIC_NETWORK=devnet
# The SDK's devnetName is the node's network id suffix: plain `sakura`.
NEXT_PUBLIC_DEVNET_NAME=sakura

# All 13 validators, listed explicitly (seed-1..3.sakura… all resolve to one
# host). Each serves a Let's Encrypt IP-SAN certificate on :1443 (the current
# set is managed by the network operator).
NEXT_PUBLIC_DAPI_ADDRESSES=https://68.67.122.86:1443,https://68.67.122.87:1443,https://68.67.122.240:1443,https://68.67.122.241:1443,https://68.67.122.88:1443,https://68.67.122.89:1443,https://68.67.122.90:1443,https://68.67.122.91:1443,https://68.67.122.92:1443,https://68.67.122.93:1443,https://68.67.122.94:1443,https://68.67.122.95:1443,https://68.67.122.232:1443

# Quorum service for the trusted context (BLS public keys that verify read
# proofs). The SDK's name-derived default (quorums.sakura…) is the same host;
# it is set explicitly anyway.
NEXT_PUBLIC_QUORUM_URL=https://quorums.sakura.networks.dash.org

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.sakura.networks.dash.org/insight-api

# Release rehearsal set, registered 2026-10-18 without resetting sakura.
# Every id is generateId(DEVNET_MAKER_IDENTITY_ID, nonce):
#   35 app anchor / group   36 social v17   37 blocks   38 DM v5
#   39 blog v9              40 pollr v8    41 storefront v10   42 passkey vault
# The previous set remains on chain; this deployment starts fresh on these ids.
# All eight contracts join the new group at creation, pinned at version 1.
# Social, blog and storefront use notYetUsable with 3600 s join/vote windows.
# Elected leaders plus three members open posting; the maker has no interim
# moderation authority. YAPP supply comes only from each identity's 100-YAPP
# starter claim: mint, burn, freeze and unfreeze authorities are noOne.
# Base profiles remain on the DashPay system contract; yapprProfile extends them.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=5sgocKC9gg3RPYdTqnmWUgpatTDd5xzsdQLe6ADk6BnP
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v17
# block, blockFilter and blockFollow (contracts/yappr-blocks-contract.json):
# unmoderated, read and written here on v13 and later.
NEXT_PUBLIC_YAPPR_BLOCKS_CONTRACT_ID=A9WdJPumwd4exLEkZBV7eXCab4MGvsSA1dRBcrbTiqD2

# Release feature ids and matching topology gates. No legacy DM v4, key
# exchange, password vault, authVault or key backup is used by this deployment.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_PASSKEY_VAULT_CONTRACT_ID=9wTMqLyXCbGRePZg2aBHGPpMYKDFpbuANbSLuh69RsSE
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=GvumHxASNGRaogZBHSryzoYg6rx9mcHr1QX5DqBYpdSJ
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=3HVUDF6Xgi8aNMc8bGyH5D445jtpx4gm1Xj3yNWLA7ep
# Pollr v8: one ballot per voter; polls are reached through embedded posts.
NEXT_PUBLIC_POLLR_CONTRACT_ID=AFZoNi1rTb3fLoAJfAuqRXeYnNnuqqc59ex2UMyeAfyp

# DM v5 (docs/DM_V5.md): unlinkable 1:1 and group messaging.
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=GRgZG766iFKEwREVqdCKmLEUyNoH1BUGXzKjxqVf84LC

# Feature topology gates, each pinned to the contract registered above.
NEXT_PUBLIC_DM_TOPOLOGY=v5
# Storefront v10 seals status notes; blog v9 uses live published listings.
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v10
NEXT_PUBLIC_BLOG_TOPOLOGY=v9
NEXT_PUBLIC_POLLR_TOPOLOGY=v8

# App Connect pins the new anchor, group, owner and exact eight members.
# Explicit id:version pins fail closed if any member changes its schema.
# Legacy login is retired; the passkey vault is a group member.
NEXT_PUBLIC_LOGIN_PROTOCOL=app-connect
# Which URI the sign-in QR code carries (DIP dashpay/dips#181): dash-key
# (default; the only one current testnet and devnet wallets accept) or
# dashpay (dashpay://connect). Mainnet always uses dashpay, whatever this says.
NEXT_PUBLIC_APP_CONNECT_CARRIER=
NEXT_PUBLIC_APP_CONNECT_APP_ID=5wfKdCWAxH8oEtsbXXw4CWoBpWSF5JAyRTZkxfVJpD7F
NEXT_PUBLIC_APP_CONNECT_GROUP_ID=8Ahhf3N5EnakHZyFTeDSmbfBGnpZpZWzz3CxH4DCr7hS
NEXT_PUBLIC_APP_CONNECT_GROUP_OWNER=9RPq2JuMsmrTUoxQLricaT245t4bYskCj4hXWcedCagH
NEXT_PUBLIC_APP_CONNECT_GROUP_MEMBERS=5wfKdCWAxH8oEtsbXXw4CWoBpWSF5JAyRTZkxfVJpD7F:1,5sgocKC9gg3RPYdTqnmWUgpatTDd5xzsdQLe6ADk6BnP:1,A9WdJPumwd4exLEkZBV7eXCab4MGvsSA1dRBcrbTiqD2:1,GRgZG766iFKEwREVqdCKmLEUyNoH1BUGXzKjxqVf84LC:1,3HVUDF6Xgi8aNMc8bGyH5D445jtpx4gm1Xj3yNWLA7ep:1,AFZoNi1rTb3fLoAJfAuqRXeYnNnuqqc59ex2UMyeAfyp:1,GvumHxASNGRaogZBHSryzoYg6rx9mcHr1QX5DqBYpdSJ:1,9wTMqLyXCbGRePZg2aBHGPpMYKDFpbuANbSLuh69RsSE:1

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Maker: index 9 of the privately retained deployment seed (the same key as on
# bonsia and moutai; replayed to the same id on the beta.5 and beta.6 chains;
# identity nonce 42 after the release rehearsal). The group id is the App Connect
# group above, kept here for humans.
# The dedicated CI seed is separate and cannot control the maker.
DEVNET_CONTRACT_GROUP_ID=8Ahhf3N5EnakHZyFTeDSmbfBGnpZpZWzz3CxH4DCr7hS
DEVNET_MAKER_IDENTITY_ID=9RPq2JuMsmrTUoxQLricaT245t4bYskCj4hXWcedCagH

# The maker still owns the contract and sponsors YAPP-paid gas. On v17 no
# identity has token moderation or manual issuance authority.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=9RPq2JuMsmrTUoxQLricaT245t4bYskCj4hXWcedCagH

# Dedicated CI bots, in derivation-index order of the E2E_DEVNET_SEED_PHRASE
# secret: index 0 is the CI identity (yappr-ci-devnet-260915), 1-8 the DM v5
# e2e bots (yappr-dm-e2e-1..8, each with the seed-derived ENCRYPTION key). Same
# keys as on bonsia; the same ids as on the beta.3 and beta.5 chains, thanks to the replay.
# Testnet credentials are unchanged.
E2E_IDENTITY_IDS=AuPAmquzMYem3mxeyAaWnzpSyok9itGU8MP19GTKMBp9,Dj2D55V8R3eVkW72XpAcpZ6J3ExLpNBr2HiSHuZd7XQw,An7sPjdxSDn2DsCoyhZjxHSWbqKtFcK3uwSLh1mXDHqa,HdiuCv9qtfTWo7R4PNFEN9B3tFxYhP5X8Cbr38jKfq87,FxjY5SSmvJqCZ6zFSGWqATvNGp1czaoLATjkEF2k57Hz,9xkQEgWa2V9v9b6Ujb9v3uJfLwVh2SXofFNXapRE64CF,7mXLFFbjNSVWyY5m8i4R5LPHhwKW7dF8vh9gNvLpGLCG,CB6dvhWfhn61Vfw17axv3AougXnMGt3oxFw8yi9DsRoc,B6Hpa1MJ3JqzA1MS38tnhRf9pBmUp4Cvkznx89NWsWEL

NEXT_PUBLIC_LOG_LEVEL=debug
