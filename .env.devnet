# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_DEVNET_NAME=moutai

# moutai has no masternode discovery, so the DAPI pool is listed explicitly.
# Five seed hostnames round-robin over three machines; only :1443 is open, and it
# serves a valid public TLS certificate.
NEXT_PUBLIC_DAPI_ADDRESSES=https://seed-1.moutai.networks.dash.org:1443,https://seed-2.moutai.networks.dash.org:1443,https://seed-3.moutai.networks.dash.org:1443,https://seed-4.moutai.networks.dash.org:1443,https://seed-5.moutai.networks.dash.org:1443

# Quorum service for the trusted context (BLS public keys used to verify read
# proofs). REQUIRED — without it every read fails: wasm-sdk 4.2.0-dev.2 panics on
# `proofs: false` ("queries without proofs are not supported yet") and refuses
# non-trusted proof verification ("Non-trusted mode is not supported in WASM").
# The SDK's default host, quorums.moutai.networks.dash.org, is live (stood up
# 2026-08-27, ELB), so the name-derived default works and this override is only
# needed if the service moves. First hits after idle can take ~10s (cold start);
# scripts warm the endpoints with a curl before connecting.
# NEXT_PUBLIC_QUORUM_URL=

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.moutai.networks.dash.org/insight-api

# Contracts on moutai (Platform 4.2.0-beta.3 / protocol 14). Superseded
# deployment IDs remain in git history.
#
# DEPLOYED 2026-09-21. The Platform state was wiped for 4.2.0-beta.3; the Core
# chain persisted, so all 153 identities were restored from their retained
# asset locks and kept their original ids. All ten contracts below were
# published fresh under the maker and enrolled in ONE contract group,
# 9eHKb3jFZwoG428DUHqJ9ftUbqeYrt7CCmGrwuGVHYbt (DEVNET_CONTRACT_GROUP_ID
# below), registered on the social create. The ids and the topology flags move
# in this ONE commit: deploy.yml rebuilds /devnet from this file on every push
# to staging, and a v8 client against a v7 contract fails totally rather than
# degrading.
#
# Social v8 keeps v7's whole read surface and adds what beta.3 made possible:
# the contract declares moderation (a banlist and a suspension list), post and
# reply may be removed by its moderators, so every reference at them is a
# `deletableDocument` one and the like/likeReply indexes lose `preallocated`;
# the five YAPP-priced doctypes declare an OPTIONAL token cost with the
# contract owner offered the gas, so a user may post on credits or on YAPP;
# post and reply charge a fixed action fee to the moderators pot (80,000,000
# and 16,000,000 credits, feeMultiplier pricing); and the YAPP token carries a
# once-per-identity distribution of 100 tokens any identity may claim once.
# Blog v3 and storefront v3 declare the same moderation; blog v3 DROPS
# documentsKeepHistory (a history-keeping type cannot be moderator-deletable),
# so the edit-history feature is gone. See docs/SOCIAL_V8.md and
# docs/PLATFORM_BETA3_UPGRADE.md.
#
# Contract ids are generateId(owner, nonce), so a maker restored at nonce 0
# would have reproduced the beta.1 ids on nonces 1-10 and the beta.2 ids on
# 11-20 while the schemas behind them changed — and both the browser SDK's
# contract cache and lib/contracts/bundled are keyed by id with every version
# equal to 1, so a cached v7 body would pass the staleness check and the client
# would silently run v7 semantics against v8. Maker identity nonces 1-20 were
# therefore burned before publication (ids take nonces 21-30).
#
# DO NOT REUSE these superseded beta.2 ids — each is bound to a DIFFERENT schema:
#   social v7     7R7vo8DE2pka17wAgXMnUMWpSox2z8eaLLdZNYJcWraG
#   profile       33nT1FrNnfngaqawEFkGKBsgd3vDK7DrQgGabqXfCk5g
#   key backup    9dxned7wkkiQ5GY4eirxjnYksM2g5KYSdGet4J6bK1eF
#   key exchange  B8yM8Q8kTRGG348xyotqx1xLfSQr6dK7k6PsAWzdCQrG
#   vault         G8tcJgkWtWS3C4iHGokJrW6kXeM1RX64kvNc3epRH1o2
#   auth vault    9WHwJuiYxwFZawe2jLkr51vN9BDAkZ2SV7yM89qaSXcV
#   storefront v2 6D1UPEqaYDwrnzy7c7STbMM6HBmksbp3zzMgSqr68Bi1
#   blog v2       G2SebukaFvvgBWS1Q61Me8sWc3TMzAhXt2QvAktuYvvf
#   DM v4         HBwg5hptWu1Ppgi9NadLad8cAYHHoQjHpUUb1t5w4cjF
#   pollr v4      7qVgjaNoZexX5xioVgVF8aZh1RsZv7hqtuXGhLtGT9n2
#   group         2k2bsaqY7Yg8zoUDCqqGypwJYGSiitLYcn38r3mhkNHM
NEXT_PUBLIC_YAPPR_CONTRACT_ID=CuSB2obg51YgNsqw3hoqNLdxVVVSU4wgnL2BN5rx5S3u
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v8
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=BrTRnGoGQFLPdnqriu7H4jv6Pfk1S5aSdovTzXzZjdQh

# Optional feature contracts. DM, storefront, blog and Pollr are now the beta.2
# re-cuts (DM v4, storefront v2, blog v2, Pollr v4), maker-owned and in the same
# contract group as social; their *_TOPOLOGY gates below must match. Key backup,
# key exchange, vault and auth vault remain the testnet-cloned schemas.
# Blank an id to turn the feature off: services fail closed (report
# unconfigured / preload skips them) instead of querying a missing contract.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=En7AnUi3eGoVzHUMrMh5J2C5LeAGhCc4Ru8nymFg4Dxs
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=6tmPMAoURDrYhh7kquovbg4MotPqmLf6rKukTGmB4pgd
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=AVYWRFXXQr3eKj6dCi1beDeyRKWp7iq7e2pkXE8sZpRo
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=D5pMHWHEDaYAHeFRk3rHS5reP5h3L8Sf4476jXjH2arS
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=CvxssNPzgvW1iJ51AxvLXtRu1vePDzkB1HiAxxBdVBr6
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=4KeUaXoJ61FqTibWBgiyKq9ZBz3rbm5xcs73vbtV3VeC
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=4yaAufauUGCV2rm1FezyjQVbY1xW2a6dTskWAnsxQW3p
NEXT_PUBLIC_POLLR_CONTRACT_ID=CR8aL9B85hT2y86DDRcF1ejUvnA3TLt2jQmmQwTqig9A

# DM v5 (docs/DM_V5.md): unlinkable 1:1 and group messaging. Registered
# 2026-09-23 by the maker at identity nonce 31 from
# contracts/yappr-dm-contract-v5.json and proved by scripts/verify-dm-v5.mjs.
# NOT in the contract group, and the client does not read it yet: the switch
# to v5 moves NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID and NEXT_PUBLIC_DM_TOPOLOGY
# together in a later commit.
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=5Uo3pfSYqoShVntf9sBZf4Si3WfUkTC3aRh9NLomzzdj

# Feature topology gates, each pinned to the contract registered above. The
# readers live on the unmerged non-social branch, so staging's lib/constants.ts
# may still ignore them; they are set now so the flag and the id never drift.
NEXT_PUBLIC_DM_TOPOLOGY=v4
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v3
NEXT_PUBLIC_BLOG_TOPOLOGY=v3
NEXT_PUBLIC_POLLR_TOPOLOGY=v4

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Maker: index 9 of the privately retained deployment seed. Restored on
# 2026-09-18 with its original id from its retained Core asset lock.
# The dedicated CI seed is separate and cannot control the maker.
DEVNET_CONTRACT_GROUP_ID=9eHKb3jFZwoG428DUHqJ9ftUbqeYrt7CCmGrwuGVHYbt
DEVNET_MAKER_IDENTITY_ID=3JKc6iVG74LEMSrAtB4VSHPQW2mtgKAw8s3Ki6tTFcRQ

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, price changes) gates on it instead of the testnet
# authority baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=3JKc6iVG74LEMSrAtB4VSHPQW2mtgKAw8s3Ki6tTFcRQ

# Dedicated CI bots, in derivation-index order of the E2E_DEVNET_SEED_PHRASE
# secret. Index 0 was restored from its saved Core asset lock; indices 1-4 were
# registered 2026-09-23 for the DM v5 specs, 5-8 the same day (the specs use 1-8;
# each identity carries the seed-derived ENCRYPTION key and a yappr-dm-e2e-<n>
# DPNS name). Testnet credentials are unchanged.
E2E_IDENTITY_IDS=EShbqnfLdmctGWaUCnU3FNKMenYmxiQEiawY3q2pLQm2,81CQGtrWH6Ya3pZ5rxbsvy9Zc6Lt9DzzddV4nFrNEzhp,2wZTPNQqt6fpTHa2nwTLKXKk285XgWxvpFjMLU49fNvx,9KSJKU3epr7LKMNTCpFwMhMAuSQmn852NgP9aY4hYTVn,2TaMxdgxkQQdAMwxq3UWeiTvxZnKAJAW9fybmwPaHART,86dNvmDQqBaMfZw69oyd6AquP7mJEGWrYBth24v35vKJ,8Xi6rYVH6jiXZz58zHddgcJe4dMyg8D546rqZ1SzYvm5,HrrWGNophXQPzxo4xcFPgNuhjPfQgtkqS5xaBZWuUjg8,Cvdqdm46UsEsNxhJCSqATdthTjdLc9QuXGBfMmqVhHdj

