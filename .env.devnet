# Registration sequence (nonce order matters after a wipe): social v6, profile,
# dm, storefront, key backup, key exchange, vault, auth vault, blog, pollr.
# The old IDs in git history are stale and must not be reused.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=CdUkSHkQwGXXAkzKqrcrjUWLsj7qErK9XAZmLzJEhirU
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v6
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=6cyzfCVkov5RqJzRpXTmCAjYWBGqB1SzsBxrsnd8AUyb

# Optional feature contracts, cloned from their testnet copies' on-chain schemas
# and published under the devnet maker after the dev.9 reset. Pollr is included;
# the testnet original is externally owned, but its devnet clone is maker-owned.
# Blank an id to turn the feature off: services fail closed (report
# unconfigured / preload skips them) instead of querying a missing contract.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=ACggUAB9rYpZUTBggrgx54R43iSprQztyuwYx16Y25xC
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=EZ4wbjXKrmTEmX6Hb8UW1TWYm2RSagK8o25KnvfsZ3z5
