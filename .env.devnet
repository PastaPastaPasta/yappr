# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Contract-maker identity: seed index 9 of the separately retained maker seed.
# The dedicated CI bot seed does not control this identity.
DEVNET_MAKER_IDENTITY_ID=EzQHpEVYB3xaAyHdkEDGaduXiYo2Eo6mQhg4wxc11Zeb

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, price changes) gates on it instead of the testnet
# authority baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=EzQHpEVYB3xaAyHdkEDGaduXiYo2Eo6mQhg4wxc11Zeb

# Dedicated devnet CI bot pool, in derivation-index order (index 0).
# Its retained seed is the E2E_DEVNET_SEED_PHRASE GitHub Actions secret;
# the testnet E2E_SEED_PHRASE and contract-maker seed remain separate.
E2E_IDENTITY_IDS=EShbqnfLdmctGWaUCnU3FNKMenYmxiQEiawY3q2pLQm2

NEXT_PUBLIC_LOG_LEVEL=debug
