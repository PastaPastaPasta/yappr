# Environment for the /devnet deployment ("staging-devnet") and local devnet runs.
#
# Loaded by `npm run build:devnet`, which sources this file before running
# `next build` with BASE_PATH=/devnet. Next.js does not auto-load `.env.devnet`,
# so the values below only take effect through that script. The same file is read
# by scripts/sdk-env.mjs, so `NETWORK=devnet node scripts/<script>.mjs` picks up
# the same wiring without repeating it on the command line.
#
# This file is checked in on purpose: contract IDs, identity IDs and node
# addresses are public data. Never put a seed phrase, WIF, or any other private
# key material here — those live in `.env.local` (gitignored) or GitHub secrets.

NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_DEVNET_NAME=moutai

# moutai has no masternode discovery, so the DAPI pool is listed explicitly.
# Five seed hostnames round-robin over three machines; only :1443 is open, and it
# serves a valid public TLS certificate.
NEXT_PUBLIC_DAPI_ADDRESSES=https://seed-1.moutai.networks.dash.org:1443,https://seed-2.moutai.networks.dash.org:1443,https://seed-3.moutai.networks.dash.org:1443,https://seed-4.moutai.networks.dash.org:1443,https://seed-5.moutai.networks.dash.org:1443

# Quorum service for the trusted context (BLS public keys used to verify read
# proofs). REQUIRED — without it every read fails: wasm-sdk 4.2.0-dev.2 panics on
# `proofs: false` ("queries without proofs are not supported yet") and refuses
# non-trusted proof verification ("Non-trusted mode is not supported in WASM").
# The SDK's default host, quorums.moutai.networks.dash.org, is live (stood up
# 2026-08-27, ELB), so the name-derived default works and this override is only
# needed if the service moves. First hits after idle can take ~10s (cold start);
# scripts warm the endpoints with a curl before connecting.
# NEXT_PUBLIC_QUORUM_URL=

# Insight reports "network":"testnet" — devnets reuse testnet address and WIF
# prefixes, which is why key derivation stays on testnet (see keyNetwork()).
NEXT_PUBLIC_INSIGHT_API_URL=https://insight.moutai.networks.dash.org/insight-api

# Contracts on moutai (Platform 4.2.0-beta.2 / protocol 14). Superseded
# deployment IDs remain in git history.
# Social v7 keeps every v6 index verbatim, including the seven-day
# (604800-second) TTL on the daily and rolling like/beat indexes, the permanent
# like counts and the beat deletion indexes. What it changes is ownership of
# two invariants: a like's postAuthor binds to the post's $ownerId through a
# system-field propertyAgreement (so post/reply no longer carry the attested
# `author` column), and post/reply declare `immutable` property lists so a
# tombstone can only blank content, never rewrite structure. See
# docs/PLATFORM_BETA2_UPGRADE.md.
# History-keeping blog types are permanent. YAPP costs 1,000,000 credits/token
# with a minimum purchase of 100 tokens.
# Registration order: social, profile, DM, storefront, key backup, key exchange,
# vault, auth vault, blog, Pollr.
#
# DEPLOYED 2026-09-18. The Platform state was wiped for 4.2.0-beta.2 (protocol
# 14); the Core chain persisted, so every identity was restored from its retained
# asset lock and kept its original id. All ten contracts below were published
# fresh under the maker and enrolled in ONE contract group,
# 2k2bsaqY7Yg8zoUDCqqGypwJYGSiitLYcn38r3mhkNHM (DEVNET_CONTRACT_GROUP_ID below),
# registered on the social create. The id and the topology flag moved as a unit.
#
# Every id is NEW and had never been used on any chain. Contract ids are
# generateId(owner, nonce), so a maker restored at nonce 0 would have reproduced
# beta.1's ids exactly while the schemas behind them changed — and both the
# browser SDK's contract cache and lib/contracts/bundled are keyed by id with
# every version equal to 1, so a cached v6 body would pass the staleness check
# and the client would silently run v6 semantics against v7. Maker identity
# nonces 1-10 were therefore burned before publication (ids take nonces 11-20).
#
# DO NOT REUSE these superseded beta.1 ids — each is bound to a DIFFERENT schema:
#   social v6     HWZdaqfPuqfVJf7ARomsVdpFPa6P2Bp1Eh9qYZSMEFEQ
#   profile       8k68ZeSy2Zkopd3iELCuV74j2ifkQ2SXKGrqP3SdqFq9
#   DM v3         2QLACBGgJ7ZVjPRvsxn7p4V79Jx2FeazHhQAnFDwezb7
#   storefront v1 u43oK1VkPVJcEXio24QRzfzjdkbKVbNHF2e6XrVpmiB
#   key backup    3KJGYbL7gpN4XTR9SjbvqSC1mwLdD8KdVyeWSJcs8Lfe
#   key exchange  2vV5tWYKM47SmkwUjcsepSAb9DcNqoJQdKepLci9rB4K
#   vault         DbY65Q4f5an4iQesY5NVQzUeUWKppBZRxnqvSzpnBWNW
#   auth vault    G3f3pMAJbKQkqDTEBKf4LGLHxfcQSJX8wqzi3fxJ9sVm
#   blog v1       H1BGrYssjwsr6wixRhMTe72kmwB1bb5XwxV2RnRHJ5u3
#   pollr v3      FafMU3ngUx5oPMMyCRgyg8YqxLyQNyGotQq3CiUamJWB
#   group         DYDGmjxwQwZhRm7zxp12pd52vB9pCunxEPerF9TfvQZe
NEXT_PUBLIC_YAPPR_CONTRACT_ID=7R7vo8DE2pka17wAgXMnUMWpSox2z8eaLLdZNYJcWraG
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v7
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=33nT1FrNnfngaqawEFkGKBsgd3vDK7DrQgGabqXfCk5g

# Optional feature contracts. DM, storefront, blog and Pollr are now the beta.2
# re-cuts (DM v4, storefront v2, blog v2, Pollr v4), maker-owned and in the same
# contract group as social; their *_TOPOLOGY gates below must match. Key backup,
# key exchange, vault and auth vault remain the testnet-cloned schemas.
# Blank an id to turn the feature off: services fail closed (report
# unconfigured / preload skips them) instead of querying a missing contract.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=HBwg5hptWu1Ppgi9NadLad8cAYHHoQjHpUUb1t5w4cjF
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=6D1UPEqaYDwrnzy7c7STbMM6HBmksbp3zzMgSqr68Bi1
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=9dxned7wkkiQ5GY4eirxjnYksM2g5KYSdGet4J6bK1eF
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=B8yM8Q8kTRGG348xyotqx1xLfSQr6dK7k6PsAWzdCQrG
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=G8tcJgkWtWS3C4iHGokJrW6kXeM1RX64kvNc3epRH1o2
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=9WHwJuiYxwFZawe2jLkr51vN9BDAkZ2SV7yM89qaSXcV
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=G2SebukaFvvgBWS1Q61Me8sWc3TMzAhXt2QvAktuYvvf
NEXT_PUBLIC_POLLR_CONTRACT_ID=7qVgjaNoZexX5xioVgVF8aZh1RsZv7hqtuXGhLtGT9n2

# Feature topology gates, each pinned to the contract registered above. The
# readers live on the unmerged non-social branch, so staging's lib/constants.ts
# may still ignore them; they are set now so the flag and the id never drift.
NEXT_PUBLIC_DM_TOPOLOGY=v4
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v2
NEXT_PUBLIC_BLOG_TOPOLOGY=v2
NEXT_PUBLIC_POLLR_TOPOLOGY=v4

# DPNS is a system contract and normally keeps the same id on every chain; set
# this only if the devnet registered it elsewhere.
# NEXT_PUBLIC_DPNS_CONTRACT_ID=

# Maker: index 9 of the privately retained deployment seed. Restored on
# 2026-09-18 with its original id from its retained Core asset lock.
# The dedicated CI seed is separate and cannot control the maker.
DEVNET_CONTRACT_GROUP_ID=2k2bsaqY7Yg8zoUDCqqGypwJYGSiitLYcn38r3mhkNHM
DEVNET_MAKER_IDENTITY_ID=3JKc6iVG74LEMSrAtB4VSHPQW2mtgKAw8s3Ki6tTFcRQ

# The devnet social contract is owned by the devnet maker, so token moderation
# (freeze/unfreeze/destroy, price changes) gates on it instead of the testnet
# authority baked into lib/constants.ts.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=3JKc6iVG74LEMSrAtB4VSHPQW2mtgKAw8s3Ki6tTFcRQ

# Dedicated CI bot: index 0 of the existing E2E_DEVNET_SEED_PHRASE secret.
# Restored from its saved Core asset lock; testnet credentials are unchanged.
E2E_IDENTITY_IDS=EShbqnfLdmctGWaUCnU3FNKMenYmxiQEiawY3q2pLQm2

NEXT_PUBLIC_LOG_LEVEL=debug
