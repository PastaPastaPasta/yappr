# Environment for the /testing deployment and local e2e builds.
#
# Loaded by `npm run build:testing`, which sources this file before running
# `next build` with BASE_PATH=/testing. Next.js does not auto-load `.env.testing`,
# so the values below only take effect through that script.
#
# This file is checked in on purpose: contract IDs and identity IDs are public
# data on Dash Platform. Never put a seed phrase, WIF, or any other private key
# material here — those live in `.env.local` (gitignored) or GitHub secrets.

# Test contracts owned by the e2e identity pool. The social and profile
# contracts are published by `node scripts/register-test-contracts.mjs`;
# re-running that script (= resetting test state) prints fresh IDs to paste here.
NEXT_PUBLIC_YAPPR_CONTRACT_ID=2qvaZNJJU2KQxSn7SB7eTyyWtjvGD8wx3cpVHZSPC4mn
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=HpQGZcLJMCTE27vFHmwdPGTUVzzcqsPpD6urGsapsBk

# The remaining contracts have no test copy yet. Left commented, the build falls
# back to the production contract IDs in lib/constants.ts, so any e2e coverage of
# DMs, the storefront, key backup, or blogs would write to production state —
# register test copies and fill these in before adding such tests.
# NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=
# NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=
# NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=
# NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=

# Comma-separated identity IDs of the e2e bot pool, in derivation-index order.
# Filled in by the provisioning runbook (`node scripts/provision-test-identity.mjs <index>`).
# DPNS names: yappr-e2e-0.dash, yappr-e2e-1.dash, yappr-e2e-2.dash
E2E_IDENTITY_IDS=GENx4QYZ4UT3KGDbtxc2E7pvECfbf8AP8kk33ULcAPXr,BSHDELUeRmVxDgfUrXY6YQ2wsZTR3ToQ83RHxUXQXHMw

NEXT_PUBLIC_LOG_LEVEL=debug
