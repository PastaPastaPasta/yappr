{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "android": {
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "devnet" },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "devnet", "YAPPR_RELEASE": "1" }
    },
    "beta": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "testnet", "YAPPR_RELEASE": "1" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "YAPPR_RELEASE": "1" }
    }
  },
  "submit": {
    "preview": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "beta": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    },
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
