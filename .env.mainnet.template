# PUBLIC build configuration only. Never put keys, seeds or credentials here.
# Copy to .env.mainnet and fill registration pins. Next never loads this
# template. npm run build:mainnet refuses blanks. See docs/MAINNET_RELEASE.md.
NEXT_PUBLIC_RELEASE=1
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_LOG_LEVEL=info

# Registered release contracts (32-byte base58 ids).
NEXT_PUBLIC_YAPPR_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_BLOCKS_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_PROFILE_CONTRACT_ID=Bwr4WHCPz5rFVAD87RqTs3izo4zpzwsEdKPWUT1NS1C7
NEXT_PUBLIC_YAPPR_DM_V5_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_STOREFRONT_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_BLOG_CONTRACT_ID=
NEXT_PUBLIC_POLLR_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_PASSKEY_VAULT_CONTRACT_ID=
NEXT_PUBLIC_CONTRACT_TOPOLOGY=v19
NEXT_PUBLIC_STOREFRONT_TOPOLOGY=v12
NEXT_PUBLIC_BLOG_TOPOLOGY=v11
NEXT_PUBLIC_POLLR_TOPOLOGY=v8
NEXT_PUBLIC_DM_TOPOLOGY=v5
NEXT_PUBLIC_PROFILE_TOPOLOGY=v2

# System contracts (profile above is DashPay v2), read on mainnet 2026-11-11
# with EvoSDK.mainnetTrusted().contracts.fetch(id). See MAINNET_RELEASE.md.
NEXT_PUBLIC_DPNS_CONTRACT_ID=GWRSAVFMjXx8HpQFaNJMqBV7MBgMK4br5UESsB4S31Ec
NEXT_PUBLIC_TOKEN_HISTORY_CONTRACT_ID=43gujrzZgXqcKBiScLa4T8XTDnRhenR9BLx8GWVHjPxF
# Maker identity and YAPP token id from registration readback. Runtime derives
# YAPP from the social contract at position 0; TOKEN_ID is its release audit pin.
NEXT_PUBLIC_YAPP_TOKEN_AUTHORITY_ID=
NEXT_PUBLIC_YAPP_TOKEN_ID=

NEXT_PUBLIC_LOGIN_PROTOCOL=app-connect
# Mainnet offers only dashpay://connect.
NEXT_PUBLIC_APP_CONNECT_CARRIER=dashpay
NEXT_PUBLIC_APP_CONNECT_APP_ID=
NEXT_PUBLIC_APP_CONNECT_GROUP_ID=
NEXT_PUBLIC_APP_CONNECT_GROUP_OWNER=
# Comma-separated id:version pairs for anchor, social, blocks, DM v5, blog,
# pollr, storefront and passkey vault. Always spell out :1, too. No profile or
# system contracts: those are granted separately. Verify exact on-chain set.
NEXT_PUBLIC_APP_CONNECT_GROUP_MEMBERS=

# D9: retired contracts MUST be explicitly blank, never inherited/defaulted.
NEXT_PUBLIC_YAPPR_DM_CONTRACT_ID=
NEXT_PUBLIC_KEY_EXCHANGE_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_VAULT_CONTRACT_ID=
NEXT_PUBLIC_YAPPR_AUTH_VAULT_CONTRACT_ID=
NEXT_PUBLIC_ENCRYPTED_KEY_BACKUP_CONTRACT_ID=

# Mainnet SDK uses its standard public endpoints. Blank devnet overrides.
NEXT_PUBLIC_DEVNET_NAME=
NEXT_PUBLIC_DAPI_ADDRESSES=
NEXT_PUBLIC_QUORUM_URL=
NEXT_PUBLIC_INSIGHT_API_URL=
# Store/Blog stay Beta; credit tips stay hidden (D23).
NEXT_PUBLIC_FEATURE_STORE=beta
NEXT_PUBLIC_FEATURE_BLOG=beta
NEXT_PUBLIC_FEATURE_CREDIT_TIPS=off
# Explicit HTTPS mainnet voting URL; evovote-testnet is refused.
# Supports {contract}, {charters}, {documentType}, {index}.
NEXT_PUBLIC_MASTERNODE_VOTE_URL=

# Archival ("uncensored") frontend flags (docs/ARCHIVE_FRONTEND.md). Release
# builds refuse any value here: keep both blank (the log flag may also be 0).
NEXT_PUBLIC_MODERATION_VIEW=
NEXT_PUBLIC_MODERATION_LOG=

# D21: build-time root storage epoch, interpreted by next.config.js, NOT a
# NEXT_PUBLIC_STORAGE_SCOPE override. Pick a new epoch for a new release set.
STORAGE_EPOCH=mainnet-release-1
# BASE_PATH, GIT_* and NEXT_PUBLIC_STORAGE_SCOPE are generated by next.config.js.
