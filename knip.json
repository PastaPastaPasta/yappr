  "project": [
    "app/**",
    "components/**",
    "contexts/**",
    "hooks/**",
    "lib/**",
    "types/**",
    "e2e/**",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "platform-auth"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreMembers": [
    "getDerivedStateFromError",
    "componentDidCatch",
    "render"
  ],
  "ignore": [
    "mobile/**"
  ]
}
