    "scripts/monitoring/incidents.mjs",
    "scripts/monitoring/manifest.mjs",
    "scripts/monitoring/run.mjs",
    "scripts/prove-merged-counts.mjs",
    "scripts/provision-test-identity.mjs",
    "scripts/register-app-connect-contracts.mjs",
    "scripts/register-feature-contract.mjs",
    "scripts/register-social-v3-draft.mjs",
    "scripts/seed/author-banks.mjs",
