    "scripts/verify-blog.mjs",
    "scripts/verify-dm-v5.mjs",
    "scripts/verify-dm.mjs",
    "scripts/verify-poll-interop.mjs",
    "scripts/verify-pollr.mjs",
    "scripts/verify-social-query-bundles.mjs",
    "scripts/verify-storefront.mjs",
    "scripts/verify-tips.mjs",
    "scripts/verify-v10.mjs"
