{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "project": [
    "app/**",
    "components/**",
    "contexts/**",
    "hooks/**",
    "lib/**",
    "types/**",
    "e2e/**",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "platform-auth",
    "ajv",
    "@dashevo/wasm-dpp2"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreMembers": [
    "getDerivedStateFromError",
    "componentDidCatch",
    "render"
  ]
}
