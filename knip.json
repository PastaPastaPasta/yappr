{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.mjs",
    "playwright.config.ts",
    "vitest.config.ts",
    "next.config.js",
    "tailwind.config.js",
    "postcss.config.js"
  ],
  "project": [
    "app/**",
    "components/**",
    "contexts/**",
    "hooks/**",
    "lib/**",
    "types/**",
    "e2e/**",
    "scripts/**"
  ],
  "ignore": [
    "vendor/**",
    "ipfs/**",
    "worktrees/**"
  ],
  "ignoreDependencies": [
    "@mantine/core",
    "@mantine/hooks",
    "platform-auth"
  ],
  "ignoreBinaries": [
    "playwright"
  ]
}
