{
  "documentSchemas": {
    "poll": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "indices": [
        {
          "name": "byCreatedAt",
          "properties": [
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "ownerAndTime",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "maxBytes": 560,
          "position": 0,
          "description": "The poll question"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "maxBytes": 160
          },
          "position": 1,
          "description": "The choices, in display order; a ballot names them by index"
        },
        "multiChoice": {
          "type": "boolean",
          "position": 2,
          "description": "True when a voter may pick several options; false = one"
        },
        "endsAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "position": 3,
          "description": "Close time, ms since epoch: after creation and at most 31 days later. Ballots are editable until then and final after"
        }
      },
      "required": [
        "$createdAt",
        "question",
        "options",
        "multiChoice",
        "endsAt"
      ],
      "propertyConstraints": {
        "endsAfterCreation": {
          "greaterThan": [
            "endsAt",
            "$createdAt"
          ]
        },
        "endsWithin31Days": {
          "lessThanOrEqual": [
            {
              "subtract": [
                "endsAt",
                "$createdAt"
              ]
            },
            2678400000
          ]
        }
      },
      "deleteConstraints": {
        "noBallots": {
          "equal": [
            {
              "countOf": [
                "vote",
                {
                  "pollId": "$id"
                }
              ]
            },
            0
          ]
        }
      },
      "additionalProperties": false,
      "description": "A poll: immutable, so the options, multiChoice and endsAt its ballots are judged against never move. Its owner may delete it only until the first ballot, withdrawn or not (noBallots). Closes at endsAt, within 31 days of creation"
    },
    "vote": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": false,
      "indices": [
        {
          "name": "byPollChoice",
          "properties": [
            {
              "pollId": "asc"
            },
            {
              "choices": "asc"
            }
          ],
          "countable": "countable"
        },
        {
          "name": "byPollVoter",
          "properties": [
            {
              "pollId": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byPoll",
          "properties": [
            {
              "pollId": "asc"
            }
          ],
          "countable": "countable"
        }
      ],
      "properties": {
        "pollId": {
          "type": "identifier",
          "position": 0,
          "description": "The poll voted on; every create and replace must land by its endsAt",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "poll",
            "where": {
              "endsAt": {
                "greaterThanOrEqual": "$updatedAt"
              }
            }
          }
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "position": 1,
          "description": "The selected options by index; absent = withdrawn. byPollChoice counts each one"
        }
      },
      "required": [
        "$updatedAt",
        "pollId"
      ],
      "immutable": [
        "pollId"
      ],
      "propertyConstraints": {
        "choicesAreOptions": {
          "allOf": [
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "count": {
                      "referenced": [
                        "pollId",
                        "options"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      1
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      2
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      3
                    ]
                  }
                ]
              }
            }
          ]
        },
        "choicesAreOptionsHigh": {
          "allOf": [
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      4
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      5
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      6
                    ]
                  }
                ]
              }
            },
            {
              "not": {
                "contains": [
                  "choices",
                  {
                    "add": [
                      {
                        "count": {
                          "referenced": [
                            "pollId",
                            "options"
                          ]
                        }
                      },
                      7
                    ]
                  }
                ]
              }
            }
          ]
        },
        "singleChoice": {
          "anyOf": [
            {
              "equal": [
                {
                  "referenced": [
                    "pollId",
                    "multiChoice"
                  ]
                },
                1
              ]
            },
            {
              "lessThanOrEqual": [
                {
                  "count": "choices"
                },
                1
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "A voter's one ballot on a poll (byPollVoter), editable until the poll closes and final after: every create and replace must land by the poll's endsAt ($updatedAt is the write's block time), and nothing deletes one. choices holds options of the poll only, one at most on a single-choice poll. byPollChoice counts every selected option; byPoll counts ballots, withdrawn ones too, for noBallots"
    }
  }
}
