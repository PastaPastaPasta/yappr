{
  "documentSchemas": {
    "poll": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": true,
      "indices": [
        {
          "name": "byCreatedAt",
          "properties": [
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "ownerAndTime",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "maxBytes": 560,
          "position": 0,
          "description": "The poll question"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "maxBytes": 160
          },
          "position": 1,
          "description": "The choices, in display order; a ballot names one by its index"
        },
        "optionCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "position": 2,
          "description": "How many options there are (rule-bound to options), so a ballot can be held to a real one"
        },
        "multiChoice": {
          "type": "boolean",
          "position": 3,
          "description": "True when a voter may pick several options; false = one"
        },
        "endsAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "position": 4,
          "description": "Close time, ms since epoch: after creation and at most 31 days later. Ballots are editable until then and final after"
        }
      },
      "required": [
        "$createdAt",
        "question",
        "options",
        "optionCount",
        "multiChoice",
        "endsAt"
      ],
      "propertyConstraints": {
        "optionCountMatches": {
          "equal": [
            {
              "count": "options"
            },
            "optionCount"
          ]
        },
        "endsAfterCreation": {
          "greaterThan": [
            "endsAt",
            "$createdAt"
          ]
        },
        "endsWithin31Days": {
          "lessThanOrEqual": [
            {
              "subtract": [
                "endsAt",
                "$createdAt"
              ]
            },
            2678400000
          ]
        }
      },
      "deleteConstraints": {
        "noBallots": {
          "equal": [
            {
              "countOf": [
                "vote",
                {
                  "pollId": "$id"
                }
              ]
            },
            0
          ]
        }
      },
      "additionalProperties": false,
      "description": "A poll: immutable, so the optionCount, multiChoice and endsAt its ballots copy never move under them. Its owner may delete it only until the first ballot, withdrawn or not (noBallots). Closes at endsAt, within 31 days of creation"
    },
    "vote": {
      "type": "object",
      "documentsMutable": true,
      "canBeDeleted": false,
      "indices": [
        {
          "name": "byPollChoice",
          "properties": [
            {
              "pollId": "asc"
            },
            {
              "choice": "asc"
            }
          ],
          "countable": "countable",
          "skipIfAbsent": [
            "choice"
          ]
        },
        {
          "name": "byPollVoter",
          "properties": [
            {
              "pollId": "asc"
            },
            {
              "$ownerId": "asc"
            },
            {
              "slot": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "byPoll",
          "properties": [
            {
              "pollId": "asc"
            }
          ],
          "countable": "countable"
        }
      ],
      "properties": {
        "pollId": {
          "type": "identifier",
          "position": 0,
          "description": "The poll voted on",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "poll",
            "where": {
              "optionCount": "pollOptionCount",
              "multiChoice": "pollMultiChoice",
              "endsAt": "pollEndsAt"
            }
          }
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "position": 1,
          "description": "Which ballot of the voter this is: always 0 on a single-choice poll (one ballot), the option itself on a multi-choice poll (one per option). Never changes"
        },
        "choice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "position": 2,
          "description": "The selected option; absent = not selected (withdrawn, or a multi-choice option unticked). Only ballots holding it are tallied"
        },
        "pollOptionCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "position": 3,
          "description": "The poll's optionCount, consensus-bound"
        },
        "pollMultiChoice": {
          "type": "boolean",
          "position": 4,
          "description": "The poll's multiChoice, consensus-bound"
        },
        "pollEndsAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "position": 5,
          "description": "The poll's endsAt, consensus-bound"
        }
      },
      "required": [
        "$updatedAt",
        "pollId",
        "slot",
        "pollOptionCount",
        "pollMultiChoice",
        "pollEndsAt"
      ],
      "immutable": [
        "pollId",
        "slot"
      ],
      "propertyConstraints": {
        "writtenBeforeClose": {
          "lessThanOrEqual": [
            "$updatedAt",
            "pollEndsAt"
          ]
        },
        "choiceIsAnOption": {
          "lessThan": [
            "choice",
            "pollOptionCount"
          ]
        },
        "slotIsAnOption": {
          "lessThan": [
            "slot",
            "pollOptionCount"
          ]
        },
        "singleUsesSlotZero": {
          "anyOf": [
            {
              "equal": [
                "pollMultiChoice",
                1
              ]
            },
            {
              "equal": [
                "slot",
                0
              ]
            }
          ]
        },
        "multiChoiceIsSlot": {
          "anyOf": [
            {
              "equal": [
                "pollMultiChoice",
                0
              ]
            },
            {
              "absent": "choice"
            },
            {
              "equal": [
                "choice",
                "slot"
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "A voter's ballot, editable until the poll closes and final after: every create and replace must land by pollEndsAt ($updatedAt is the write's block time), and nothing deletes one. Single choice: one ballot (slot 0) whose choice may change or be dropped. Multi choice: one ballot per option (slot = option) whose choice is ticked (= slot) or dropped. byPollChoice skips unselected ballots, so it tallies selections; byPoll counts them all for noBallots"
    }
  }
}
