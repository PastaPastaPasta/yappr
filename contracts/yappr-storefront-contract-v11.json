                }
              ]
            },
            {
              "present": "currency"
            }
          ]
        },
        "onePrice": {
          "lessThanOrEqual": [
            {
              "countPresent": [
                "basePrice",
                "variants"
              ]
            },
            1
          ]
        },
        "oneStock": {
          "lessThanOrEqual": [
            {
              "countPresent": [
                "stockQuantity",
                "variants"
              ]
            },
            1
          ]
        },
        "optionTable": {
          "allOf": [
            {
              "equal": [
                {
                  "count": "variants.optionIds"
                },
                {
                  "count": "variants.options"
                }
              ]
            },
            {
              "equal": [
                {
                  "count": "variants.optionAxes"
                },
                {
                  "count": "variants.options"
                }
              ]
            }
          ]
        },
        "comboTable": {
          "equal": [
            {
              "count": "variants.selectors"
            },
            {
              "count": "variants.prices"
            }
          ]
        },
        "comboStocks": {
          "anyOf": [
            {
              "absent": "variants.stocks"
