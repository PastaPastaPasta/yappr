        "mediaUrl": {
          "type": "string",
          "pattern": "^https?://.+$",
          "position": 1,
          "maxLength": 512,
          "description": "URL to media file (temporary field - will support multiple media in future)"
        },
        "quotedPostId": {
          "type": "array",
          "maxItems": 32,
          "minItems": 32,
          "position": 2,
          "byteArray": true,
          "description": "ID of the quoted post",
          "contentMediaType": "application/x.dash.dpp.identifier",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "post"
          }
        },
