          "contentMediaType": "application/x.dash.dpp.identifier"
        },
        "embedContractId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
