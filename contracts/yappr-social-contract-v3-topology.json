          "refersTo": {
            "type": "permanentDocument",
            "documentType": "reply"
          }
        },
        "deleted": {
          "type": "boolean",
          "position": 13,
          "description": "Tombstone marker: true once the post has been cleared by its author (posts can never be deleted on this contract)"
        }
