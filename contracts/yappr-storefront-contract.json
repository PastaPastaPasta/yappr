{
  "config": {
    "$formatVersion": "2",
    "moderation": {
      "banlist": true,
      "suspensions": true,
      "warnings": true,
      "moderators": {
        "$type": "elected",
        "seatContestable": true,
        "challengeCoolDown": 2592000,
        "joinWindow": 604800,
        "voteWindow": 259200,
        "maxAddedModerators": 10,
        "moderatedDocumentTypes": {
          "store": [
            "deleteDocuments",
            "ban",
            "suspend",
            "warn"
          ],
          "storeItem": [
            "deleteDocuments",
            "ban",
            "suspend",
            "warn"
          ],
          "storeReview": [
            "deleteDocuments",
            "ban",
            "suspend",
            "warn"
          ],
          "itemReview": [
            "deleteDocuments",
            "ban",
            "suspend",
            "warn"
          ]
        },
        "interim": {
          "$type": "contractOwner"
        },
        "ownerProtected": true
      }
    }
  },
  "documentSchemas": {
    "store": {
      "type": "object",
      "indices": [
        {
          "name": "owner",
          "unique": true,
          "properties": [
            {
              "$ownerId": "asc"
            }
          ]
        },
        {
          "name": "byStatus",
          "properties": [
            {
              "status": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "byCategory",
          "properties": [
            {
              "status": "asc"
            },
            {
              "category": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": {
            "at": "category"
          }
        }
      ],
      "required": [
        "$createdAt",
        "name",
        "status",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string",
          "position": 0,
          "maxLength": 100,
          "minLength": 1,
          "description": "Store name"
        },
        "description": {
          "type": "string",
          "position": 1,
          "maxLength": 500,
          "description": "Store description"
        },
        "logoUrl": {
          "type": "string",
          "pattern": "^(https|ipfs)://.+$",
          "position": 2,
          "maxLength": 512,
          "description": "URL to store logo image"
        },
        "bannerUrl": {
          "type": "string",
          "pattern": "^(https|ipfs)://.+$",
          "position": 3,
          "maxLength": 512,
          "description": "URL to store banner image"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "closed"
          ],
          "position": 4,
          "description": "Store status",
          "maxLength": 6
        },
        "paymentUris": {
          "type": "string",
          "position": 5,
          "maxLength": 2000,
          "description": "JSON array of payment URIs (dash:, bitcoin:, etc.)"
        },
        "defaultCurrency": {
          "type": "string",
          "position": 6,
          "maxLength": 10,
          "description": "Default currency code (USD, EUR, DASH, etc.)",
          "maxBytes": 10
        },
        "policies": {
          "type": "string",
          "position": 7,
          "maxLength": 2000,
          "description": "Store policies (shipping, returns, etc.)"
        },
        "location": {
          "type": "string",
          "position": 8,
          "maxLength": 100,
          "description": "Store location"
        },
        "contactMethods": {
          "type": "string",
          "position": 9,
          "maxLength": 1000,
          "description": "JSON object of contact methods (email, signal, twitter, telegram)"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 20,
          "position": 10,
          "description": "Seller-chosen category as a lowercase slug (e.g. vintage-clothing), so stores group under one key"
        }
      },
      "description": "A merchant store profile (one per user), listed by status and category. Owners cannot delete one (`closed` is the tombstone); the contract's moderators can remove it, leaving a removal record.",
      "additionalProperties": false,
      "canBeDeleted": false,
      "moderatorAbilities": {
        "delete": true
      },
      "actionFees": {
        "pricing": "feeMultiplier",
        "create": {
          "moderators": 1000000000
        }
      }
    },
    "storeItem": {
      "type": "object",
      "indices": [
        {
          "name": "storeAndTime",
          "properties": [
            {
              "storeId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "storeId",
        "title",
        "status"
      ],
      "properties": {
        "storeId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the store this item belongs to; only that store's owner may write it",
          "refersTo": {
            "type": "moderatedDocument",
            "documentType": "store",
            "where": {
              "$ownerId": "$ownerId"
            }
          }
        },
        "title": {
          "type": "string",
          "position": 1,
          "maxLength": 200,
          "minLength": 1,
          "description": "Product title"
        },
        "description": {
          "type": "string",
          "position": 2,
          "maxLength": 2000,
          "description": "Product description"
        },
        "section": {
          "type": "string",
          "position": 3,
          "maxLength": 50,
          "description": "Top-level category section (e.g., Toys and Games)"
        },
        "category": {
          "type": "string",
          "position": 4,
          "maxLength": 50,
          "description": "Category within section (e.g., Table Top Games)"
        },
        "subcategory": {
          "type": "string",
          "position": 5,
          "maxLength": 50,
          "description": "Subcategory (e.g., Catan Pieces)"
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "position": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "maxBytes": 128
          },
          "description": "Search tags: at most 32 distinct tags of up to 64 characters"
        },
        "imageUrls": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "position": 7,
          "items": {
            "type": "string",
            "maxLength": 512,
            "maxBytes": 512,
            "pattern": "^(https?|ipfs)://.+$"
          },
          "description": "Product image URLs (https:// or ipfs://), at most 8, no duplicates"
        },
        "basePrice": {
          "type": "integer",
          "minimum": 0,
          "position": 8,
          "description": "Base price in smallest currency unit (cents/satoshis). Null if variants define pricing.",
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "position": 9,
          "maxLength": 10,
          "description": "Currency code (USD, EUR, DASH, etc.)",
          "maxBytes": 10
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "sold_out",
            "deleted"
          ],
          "position": 10,
          "maxLength": 8,
          "description": "Item status"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "position": 11,
          "description": "Weight in grams (for shipping calculation)",
          "maximum": 4294967295
        },
        "stockQuantity": {
          "type": "integer",
          "minimum": 0,
          "position": 12,
          "description": "Available stock (informational only)",
          "maximum": 4294967295
        },
        "sku": {
          "type": "string",
          "position": 13,
          "maxLength": 50,
          "description": "Stock keeping unit identifier"
        },
        "variants": {
          "type": "string",
          "position": 14,
          "maxLength": 5120,
          "description": "JSON object with axes and combinations for product variants",
          "maxBytes": 5120
        },
        "fulfillment": {
          "type": "string",
          "enum": [
            "shipped",
            "digital"
          ],
          "position": 15,
          "description": "How the product reaches the buyer: `shipped` (a physical parcel; also what an absent value means) or `digital` (delivered on chain as an encrypted orderDelivery, no address or shipping)",
          "maxLength": 7
        }
      },
      "description": "A product listing with optional embedded variants. Owners cannot delete one (moderators can, on the record); status `deleted` is the tombstone. Only the store owner can create or edit one, and storeId is frozen. `fulfillment` marks a digital product, whose files/links/keys the seller keeps in an itemDeliverable.",
      "additionalProperties": false,
      "canBeDeleted": false,
      "immutable": [
        "storeId"
      ],
      "propertyConstraints": {
        "pricedHasCurrency": {
          "anyOf": [
            {
              "allOf": [
                {
                  "absent": "basePrice"
                },
                {
                  "absent": "variants"
                }
              ]
            },
            {
              "present": "currency"
            }
          ]
        }
      },
      "moderatorAbilities": {
        "delete": true
      },
      "actionFees": {
        "pricing": "feeMultiplier",
        "create": {
          "moderators": 50000000
        }
      }
    },
    "shippingZone": {
      "type": "object",
      "indices": [
        {
          "name": "storeAndName",
          "unique": true,
          "properties": [
            {
              "storeId": "asc"
            },
            {
              "name": "asc"
            }
          ]
        },
        {
          "name": "storeAndPriority",
          "properties": [
            {
              "storeId": "asc"
            },
            {
              "priority": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "storeId",
        "name",
        "rateType"
      ],
      "properties": {
        "storeId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the store this zone belongs to; only that store's owner may write it",
          "refersTo": {
            "type": "moderatedDocument",
            "documentType": "store",
            "where": {
              "$ownerId": "$ownerId"
            }
          }
        },
        "name": {
          "type": "string",
          "position": 1,
          "maxLength": 63,
          "minLength": 1,
          "description": "Zone name (e.g., Domestic, Europe, Local)"
        },
        "postalPatterns": {
          "type": "string",
          "position": 2,
          "maxLength": 2000,
          "description": "JSON array of regex patterns for postal codes"
        },
        "countryPattern": {
          "type": "string",
          "position": 3,
          "maxLength": 200,
          "description": "Regex pattern for country codes"
        },
        "rateType": {
          "type": "string",
          "enum": [
            "flat",
            "weight_tiered",
            "price_tiered"
          ],
          "position": 4,
          "description": "How shipping rate is calculated",
          "maxLength": 13
        },
        "flatRate": {
          "type": "integer",
          "minimum": 0,
          "position": 5,
          "description": "Flat shipping rate (when rateType is flat)",
          "maximum": 9007199254740991
        },
        "tiers": {
          "type": "string",
          "position": 6,
          "maxLength": 5000,
          "description": "JSON array of tier definitions [{min, max, rate}]"
        },
        "currency": {
          "type": "string",
          "position": 7,
          "maxLength": 10,
          "description": "Currency for shipping rates",
          "maxBytes": 10
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "position": 8,
          "description": "Zone matching priority (lower = higher priority)"
        }
      },
      "description": "A shipping zone for a store. Only the store owner can create or edit one, and storeId is frozen.",
      "additionalProperties": false,
      "immutable": [
        "storeId"
      ],
      "propertyConstraints": {
        "flatRateHasCurrency": {
          "anyOf": [
            {
              "absent": "flatRate"
            },
            {
              "present": "currency"
            }
          ]
        },
        "tieredHasTiers": {
          "anyOf": [
            {
              "equal": [
                "rateType",
                {
                  "const": "flat"
                }
              ]
            },
            {
              "present": "tiers"
            }
          ]
        }
      }
    },
    "itemDeliverable": {
      "type": "object",
      "description": "The seller's private delivery kit for a digital storeItem: files (encrypted on IPFS, with their keys), links, license keys and instructions, ECIES-encrypted to the seller's OWN encryption key so any of their devices can fulfil an order. One per item; only the item's owner may write it, and itemId is frozen. Mutable because each sale consumes license keys.",
      "properties": {
        "itemId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the digital item this kit fulfils; only that item's owner may write it",
          "refersTo": {
            "type": "moderatedDocument",
            "documentType": "storeItem",
            "where": {
              "$ownerId": "$ownerId"
            }
          }
        },
        "encryptedPayload": {
          "type": "array",
          "byteArray": true,
          "minItems": 1,
          "maxItems": 5120,
          "position": 1,
          "description": "ECIES (secp256k1 + XChaCha20-Poly1305) ciphertext of the kit, encrypted to the seller's own encryption key"
        }
      },
      "required": [
        "$createdAt",
        "itemId",
        "encryptedPayload"
      ],
      "indices": [
        {
          "name": "itemDeliverable",
          "unique": true,
          "properties": [
            {
              "itemId": "asc"
            }
          ]
        }
      ],
      "immutable": [
        "itemId"
      ],
      "additionalProperties": false
    },
    "storeOrder": {
      "type": "object",
      "indices": [
        {
          "name": "buyerOrders",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "rangeCountable": true
        },
        {
          "name": "storeOrders",
          "properties": [
            {
              "storeId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": {
            "at": "storeId"
          }
        }
      ],
      "required": [
        "$createdAt",
        "storeId",
        "sellerId",
        "encryptedPayload",
        "nonce",
        "storeStatus"
      ],
      "properties": {
        "storeId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the store; its owner is copied into sellerId and its status into storeStatus",
          "refersTo": {
            "type": "moderatedDocument",
            "documentType": "store",
            "where": {
              "$ownerId": "sellerId",
              "status": "storeStatus"
            }
          }
        },
        "sellerId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 1,
          "description": "Store owner's identity, consensus-bound to the store's $ownerId",
          "distinctFrom": "$ownerId"
        },
        "encryptedPayload": {
          "type": "array",
          "maxItems": 5120,
          "minItems": 1,
          "position": 2,
          "byteArray": true,
          "description": "XChaCha20-Poly1305 encrypted order data (items, address, payment info)"
        },
        "nonce": {
          "type": "array",
          "maxItems": 24,
          "minItems": 24,
          "position": 3,
          "byteArray": true,
          "description": "24-byte nonce for XChaCha20-Poly1305 encryption"
        },
        "storeStatus": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "closed"
          ],
          "position": 4,
          "description": "The store's status when the order was placed, consensus-bound to store.status; must be active",
          "maxLength": 6
        }
      },
      "description": "An encrypted order created by a buyer. Permanent so status updates and reviews can reference it. The buyer IS $ownerId, and `sellerId` is consensus-equal to the store's owner, so both parties are facts rather than buyer-supplied claims; reviews and status updates bind to them.",
      "additionalProperties": false,
      "documentsMutable": false,
      "canBeDeleted": false,
      "propertyConstraints": {
        "storeIsOpen": {
          "equal": [
            "storeStatus",
            {
              "const": "active"
            }
          ]
        }
      }
    },
    "orderStatusUpdate": {
      "type": "object",
      "indices": [
        {
          "name": "orderAndTime",
          "properties": [
            {
              "orderId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "buyerFeed",
          "properties": [
            {
              "orderId.$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "orderId",
        "status"
      ],
      "properties": {
        "orderId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the order being updated; only its seller may write this",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "storeOrder",
            "where": {
              "sellerId": "$ownerId"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "payment_received",
            "processing",
            "shipped",
            "delivered",
            "cancelled",
            "refunded",
            "disputed"
          ],
          "position": 1,
          "description": "Order status",
          "maxLength": 16
        },
        "trackingNumber": {
          "type": "string",
          "position": 2,
          "maxLength": 100,
          "description": "Shipping tracking number"
        },
        "trackingCarrier": {
          "type": "string",
          "position": 3,
          "maxLength": 50,
          "description": "Shipping carrier name"
        },
        "message": {
          "type": "string",
          "position": 4,
          "maxLength": 500,
          "description": "Optional message to buyer"
        }
      },
      "description": "A status update for an order: one immutable, undeletable document per change, so the order's documents ARE its history. Only the order's seller can write one (writer gate on sellerId); buyerFeed files it under the order's owner, read through orderId, for buyer notifications.",
      "additionalProperties": false,
      "documentsMutable": false,
      "canBeDeleted": false
    },
    "orderDelivery": {
      "type": "object",
      "description": "Digital goods the seller delivered for an order (file keys, links, license keys, a message). Only the order's SELLER can write one (writer gate against the order's sellerId) and buyerDeliveries files it under the order's owner, read through orderId, so the buyer's library carries only real deliveries. Encrypted under a key both parties derive from the order's own ECDH secret; permanent and append-only, so a delivery is a receipt.",
      "properties": {
        "orderId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the order being fulfilled; only its seller may write this",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "storeOrder",
            "where": {
              "sellerId": "$ownerId"
            }
          }
        },
        "encryptedPayload": {
          "type": "array",
          "byteArray": true,
          "minItems": 1,
          "maxItems": 5120,
          "position": 1,
          "description": "XChaCha20-Poly1305 ciphertext of the delivery, keyed from the order's buyer/seller ECDH secret"
        },
        "nonce": {
          "type": "array",
          "byteArray": true,
          "minItems": 24,
          "maxItems": 24,
          "position": 2,
          "description": "24-byte nonce for XChaCha20-Poly1305 encryption"
        }
      },
      "required": [
        "$createdAt",
        "orderId",
        "encryptedPayload",
        "nonce"
      ],
      "indices": [
        {
          "name": "orderDeliveries",
          "properties": [
            {
              "orderId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "buyerDeliveries",
          "properties": [
            {
              "orderId.$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        }
      ],
      "additionalProperties": false,
      "documentsMutable": false,
      "canBeDeleted": false
    },
    "storeReview": {
      "type": "object",
      "indices": [
        {
          "name": "storeReviews",
          "properties": [
            {
              "storeId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "orderReview",
          "unique": true,
          "properties": [
            {
              "orderId": "asc"
            }
          ]
        },
        {
          "name": "storeRating",
          "properties": [
            {
              "storeId": "asc"
            }
          ],
          "summable": "rating",
          "averageable": "rating",
          "rangeCountable": true,
          "rangeSummable": true,
          "rangeAverageable": true,
          "rankedAverageable": true
        },
        {
          "name": "storeRatingDistribution",
          "properties": [
            {
              "storeId": "asc"
            },
            {
              "rating": "asc"
            }
          ],
          "countable": "countable"
        }
      ],
      "required": [
        "$createdAt",
        "storeId",
        "orderId",
        "sellerId",
        "rating"
      ],
      "properties": {
        "storeId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 0,
          "description": "ID of the store being reviewed",
          "refersTo": {
            "type": "moderatedDocument",
            "documentType": "store"
          }
        },
        "orderId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 1,
          "description": "ID of the completed order (proves purchase); only its buyer may review it",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "storeOrder",
            "where": {
              "storeId": "storeId",
              "sellerId": "sellerId",
              "$ownerId": "$ownerId"
            }
          }
        },
        "sellerId": {
          "type": "array",
          "byteArray": true,
          "minItems": 32,
          "maxItems": 32,
          "contentMediaType": "application/x.dash.dpp.identifier",
          "position": 2,
          "description": "Store owner's identity, consensus-bound to the order's sellerId (for seller queries)",
          "distinctFrom": "$ownerId"
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "position": 3,
          "description": "Star rating (1-5)"
        },
        "title": {
          "type": "string",
          "position": 4,
          "maxLength": 100,
          "description": "Review title"
        },
        "content": {
          "type": "string",
          "position": 5,
          "maxLength": 1000,
          "description": "Review content"
        }
