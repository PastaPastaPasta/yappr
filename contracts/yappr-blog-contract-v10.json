{
  "config": {
    "$formatVersion": "2",
    "moderation": {
      "warnings": true,
      "moderators": {
        "$type": "elected",
        "seatContestable": true,
        "challengeCoolDown": 1209600,
        "joinWindow": 604800,
        "voteWindow": 259200,
        "maxAddedModerators": 10,
        "moderatedDocumentTypes": {
          "blog": [
            "changeDocumentFields",
            "warn"
          ],
          "blogPost": [
            "changeDocumentFields",
            "warn"
          ],
          "blogComment": [
            "changeDocumentFields",
            "warn"
          ],
          "report": [
            "changeDocumentFields"
          ],
          "restriction": [
            "changeDocumentFields"
          ]
        },
        "interim": {
          "$type": "notYetUsable"
        },
        "ownerProtected": false
      }
    }
  },
  "documentSchemas": {
    "blog": {
      "type": "object",
      "canBeDeleted": true,
      "indices": [
        {
          "name": "ownerAndTime",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "timeline",
          "properties": [
            {
              "mod": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "moderated",
          "properties": [
            {
              "mod": "asc"
            },
            {
              "$moderatedAt": "asc"
            }
          ],
          "skipIfAbsent": [
            "mod"
          ]
        }
      ],
      "required": [
        "$createdAt",
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "position": 0,
          "description": "Blog name",
          "maxBytes": 192
        },
        "description": {
          "type": "string",
          "maxLength": 256,
          "position": 1,
          "description": "Blog description",
          "maxBytes": 768
        },
        "headerImage": {
          "type": "string",
          "maxLength": 256,
          "position": 2,
          "description": "ipfs:// URI for header/banner image",
          "pattern": "^(https|ipfs)://.+$",
          "maxBytes": 256
        },
        "avatar": {
          "type": "string",
          "maxLength": 256,
          "position": 3,
          "description": "ipfs:// URI for blog avatar",
          "pattern": "^(https|ipfs)://.+$",
          "maxBytes": 256
        },
        "themeConfig": {
          "type": "array",
          "byteArray": true,
          "minItems": 1,
          "maxItems": 5000,
          "position": 4,
          "description": "Compressed JSON theme configuration"
        },
        "commentsEnabledDefault": {
          "type": "boolean",
          "position": 5,
          "description": "Default comments setting for new posts"
        },
        "labels": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "position": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "maxBytes": 160
          },
          "description": "The blog's label taxonomy: at most 64 distinct labels of up to 40 characters"
        },
        "mod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "position": 7
        },
        "modLabel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63,
          "position": 8
        }
      },
      "additionalProperties": false,
      "description": "A blog (many per user). Its author can delete it; posts remain as records and stop appearing on the blog page and in discovery.",
      "moderatorAbilities": {
        "changeFields": [
          "mod",
          "modLabel"
        ]
      },
      "actionFees": {
        "pricing": "feeMultiplier",
        "create": {
          "moderators": 500000000
        }
      },
      "propertyConstraints": {
        "modReason": {
          "anyOf": [
            {
              "absent": "mod"
            },
            {
              "present": "modLabel"
            }
          ]
        }
      }
    },
    "blogPost": {
      "type": "object",
      "canBeDeleted": false,
      "indices": [
        {
          "name": "blogAndTime",
          "properties": [
            {
              "live": "asc"
            },
            {
              "mod": "asc"
            },
            {
              "blogId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "skipIfAbsent": [
            "live"
          ]
        },
        {
          "name": "blogAndSlug",
          "unique": true,
          "properties": [
            {
              "blogId": "asc"
            },
            {
              "slug": "asc"
            }
          ],
          "skipIfAbsent": true
        },
        {
          "name": "timeline",
          "properties": [
            {
              "live": "asc"
            },
            {
              "mod": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "skipIfAbsent": [
            "live"
          ]
        },
        {
          "name": "ownerAndTime",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "live": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "skipIfAbsent": true
        },
        {
          "name": "moderated",
          "properties": [
            {
              "mod": "asc"
            },
            {
              "$moderatedAt": "asc"
            }
          ],
          "skipIfAbsent": [
            "mod"
          ]
        }
      ],
      "required": [
        "$createdAt",
        "$updatedAt",
        "slug",
        "publishedAt"
      ],
      "properties": {
        "blogId": {
          "type": "identifier",
          "position": 0,
          "description": "Reference to parent blog document",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "blog",
            "where": {
              "$ownerId": "$ownerId"
            }
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "position": 1,
          "description": "Post title",
          "maxBytes": 384
        },
        "subtitle": {
          "type": "string",
          "maxLength": 256,
          "position": 2,
          "description": "Post subtitle",
          "maxBytes": 768
        },
        "data0": {
          "type": "array",
          "byteArray": true,
          "minItems": 1,
          "maxItems": 5120,
          "position": 3,
          "description": "Compressed content chunk 0 (max 5120 bytes per platform field limit)"
        },
        "data1": {
          "type": "array",
          "byteArray": true,
          "maxItems": 5120,
          "position": 4,
          "description": "Compressed content chunk 1 (overflow)"
        },
        "data2": {
          "type": "array",
          "byteArray": true,
          "maxItems": 5120,
          "position": 5,
          "description": "Compressed content chunk 2 (overflow)"
        },
        "data3": {
          "type": "array",
          "byteArray": true,
          "maxItems": 5120,
          "position": 6,
          "description": "Compressed content chunk 3 (overflow)"
        },
        "coverImage": {
          "type": "string",
          "maxLength": 256,
          "position": 7,
          "description": "ipfs:// URI for cover image",
          "pattern": "^(https|ipfs)://.+$",
          "maxBytes": 256
        },
        "labels": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "position": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "maxBytes": 160
          },
          "description": "Labels from the blog taxonomy: at most 16 distinct labels of up to 40 characters"
        },
        "commentsEnabled": {
          "type": "boolean",
          "position": 9,
          "description": "Whether comments are enabled"
        },
        "slug": {
          "type": "string",
          "maxLength": 63,
          "position": 10,
          "description": "URL-safe slug derived from title",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "publishedAt": {
          "type": "integer",
          "minimum": 0,
          "position": 11,
          "description": "Publication timestamp (ms since epoch)"
        },
        "deleted": {
          "type": "boolean",
          "position": 12
        },
        "live": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "position": 13
        },
        "mod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "position": 14
        },
        "modLabel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63,
          "position": 15
        }
      },
      "additionalProperties": false,
      "description": "A published post (publishedAt is required: drafts stay on the device). Permanent for its owner: an author's delete is a tombstone, which leaves the live listings (timeline, blogAndTime). The contract's moderators may remove it. The author IS $ownerId, which a comment's postOwnerAndTime index reads through blogPostId, so no attested copy is carried.",
      "immutable": [
        "blogId",
        "publishedAt",
        {
          "property": "deleted",
          "when": {
            "present": "$old.deleted"
          }
        },
        {
          "property": "live",
          "when": {
            "absent": "deleted"
          }
        }
      ],
      "moderatorAbilities": {
        "changeFields": [
          "mod",
          "modLabel"
        ]
      },
      "propertyConstraints": {
        "chunksContiguous": {
          "allOf": [
            {
              "anyOf": [
                {
                  "absent": "data2"
                },
                {
                  "present": "data1"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "absent": "data3"
                },
                {
                  "present": "data2"
                }
              ]
            }
          ]
        },
        "hasBody": {
          "anyOf": [
            {
              "present": "deleted"
            },
            {
              "allOf": [
                {
                  "present": "title"
                },
                {
                  "present": "data0"
                },
                {
                  "present": "blogId"
                }
              ]
            }
          ]
        },
        "tombstoneIsBlank": {
          "anyOf": [
            {
              "absent": "deleted"
            },
            {
              "allOf": [
                {
                  "equal": [
                    "deleted",
                    1
                  ]
                },
                {
                  "present": "commentsEnabled"
                },
                {
                  "equal": [
                    "commentsEnabled",
                    0
                  ]
                },
                {
                  "absent": "title"
                },
                {
                  "absent": "subtitle"
                },
                {
                  "absent": "data0"
                },
                {
                  "absent": "data1"
                },
                {
                  "absent": "data2"
                },
                {
                  "absent": "data3"
                },
                {
                  "absent": "coverImage"
                },
                {
                  "absent": "labels"
                }
              ]
            }
          ]
        },
        "publishedNotAhead": {
          "lessThanOrEqual": [
            "publishedAt",
            {
              "add": [
                "$updatedAt",
                600000
              ]
            }
          ]
        },
        "live": {
          "equal": [
            {
              "countPresent": [
                "deleted",
                "live"
              ]
            },
            1
          ]
        },
        "restrictedLane": {
          "ifThen": [
            {
              "equal": [
                "$revision",
                1
              ]
            },
            {
              "equal": [
                "live",
                {
                  "add": [
                    1,
                    {
                      "min": [
                        {
                          "countOf": [
                            "restriction",
                            {
                              "target": "$ownerId",
                              "state": 1
                            }
                          ]
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "modReason": {
          "anyOf": [
            {
              "absent": "mod"
            },
            {
              "present": "modLabel"
            }
          ]
        }
      },
      "actionFees": {
        "pricing": "feeMultiplier",
        "create": {
          "moderators": 20000000
        }
      }
    },
    "blogComment": {
      "type": "object",
      "documentsMutable": false,
      "indices": [
        {
          "name": "postAndTime",
          "properties": [
            {
              "blogPostId": "asc"
            },
            {
              "mod": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "rangeCountable": true
        },
        {
          "name": "postOwnerAndTime",
          "properties": [
            {
              "blogPostId.$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "discussedRecent",
          "properties": [
            {
              "$createdAt": "asc"
            },
            {
              "blogPostId": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": true,
          "timeRange": {
            "on": "$createdAt",
            "range": 259200,
            "step": 86400,
            "ttl": 604800
          }
        },
        {
          "name": "ownerAndTime",
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "moderated",
          "properties": [
            {
              "mod": "asc"
            },
            {
              "$moderatedAt": "asc"
            }
          ],
          "skipIfAbsent": [
            "mod"
          ]
        }
      ],
      "required": [
        "$createdAt",
        "blogPostId",
        "content"
      ],
      "properties": {
        "blogPostId": {
          "type": "identifier",
          "position": 0,
          "description": "Reference to parent blog post document, which must not have comments turned off",
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "blogPost",
            "where": {
              "commentsEnabled": {
                "notEqual": {
                  "const": false
                }
              }
            }
          }
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "position": 1,
          "description": "Comment content",
          "maxBytes": 1500
        },
        "mod": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "position": 2
        },
        "modLabel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63,
          "position": 3
        }
      },
      "additionalProperties": false,
      "description": "A comment on a post. blogPostId must name a real post, and postOwnerAndTime reads that post's $ownerId through it (blogPostId.$ownerId), so the notification key cannot be forged and comments on ghost posts are impossible.",
      "moderatorAbilities": {
        "changeFields": [
          "mod",
          "modLabel"
        ]
      },
      "actionFees": {
        "pricing": "feeMultiplier",
        "create": {
          "moderators": 10000000
        }
      },
      "propertyConstraints": {
        "modReason": {
          "anyOf": [
            {
              "absent": "mod"
            },
            {
              "present": "modLabel"
            }
          ]
        }
      }
    },
    "blogFollow": {
      "type": "object",
      "documentsMutable": false,
      "indices": [
        {
          "name": "ownerAndBlog",
          "unique": true,
          "properties": [
            {
              "$ownerId": "asc"
            },
            {
              "blogId": "asc"
            }
          ]
        },
        {
          "name": "followers",
          "properties": [
            {
              "blogId": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": {
            "at": "blogId"
          }
        },
        {
          "name": "followersTrend",
          "properties": [
            {
              "$createdAt": "asc"
            },
            {
              "blogId": "asc"
            }
          ],
          "rangeCountable": true,
          "rankedCountable": true,
          "timeRange": {
            "on": "$createdAt",
            "range": 259200,
            "step": 86400,
            "ttl": 604800
          }
        }
      ],
      "required": [
        "$createdAt",
        "blogId"
      ],
      "properties": {
        "blogId": {
          "type": "identifier",
          "position": 0,
          "description": "Reference to the blog being followed",
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "blog"
          }
        }
      },
      "additionalProperties": false,
      "description": "A follow of a blog, one per (follower, blog). Counted and ranked so discovery reads \"most followed\" and \"trending today\" instead of crawling every blog's followers."
    },
    "report": {
      "type": "object",
      "documentsMutable": false,
      "moderatorAbilities": {
        "changeFields": [
          "status",
          "resolution"
        ]
      },
      "required": [
        "$createdAt",
        "targetOwnerId",
        "reason"
      ],
      "propertyConstraints": {
        "oneTarget": {
          "equal": [
            {
              "countPresent": [
                "blogId",
                "blogPostId",
                "blogCommentId"
              ]
            },
            1
          ]
        },
        "otherNote": {
          "anyOf": [
            {
              "notEqual": [
                "reason",
                8
              ]
            },
            {
              "present": "note"
            }
          ]
        },
        "resolvedStatus": {
          "anyOf": [
            {
              "absent": "resolution"
            },
            {
              "present": "status"
            }
          ]
        },
        "staysResolved": {
          "ifThen": [
            {
              "present": "$old.status"
            },
            {
              "present": "status"
            }
          ]
        }
      },
      "actionFees": {
        "pricing": "feeMultiplier",
        "create": {
          "moderators": 20000000
        }
      },
      "additionalProperties": false,
      "ttl": 7776000,
      "deleteConstraints": {
        "pending": {
          "absent": "status"
        }
      },
      "properties": {
        "blogId": {
          "type": "identifier",
          "position": 0,
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "blog",
            "where": {
              "$ownerId": "targetOwnerId"
            }
          }
        },
        "blogPostId": {
          "type": "identifier",
          "position": 1,
          "refersTo": {
            "type": "permanentDocument",
            "documentType": "blogPost",
            "where": {
              "$ownerId": "targetOwnerId"
            }
          }
        },
        "blogCommentId": {
          "type": "identifier",
          "position": 2,
          "refersTo": {
            "type": "deletableDocument",
            "documentType": "blogComment",
            "where": {
              "$ownerId": "targetOwnerId"
            }
          }
        },
        "targetOwnerId": {
          "type": "identifier",
          "position": 3,
          "distinctFrom": "$ownerId"
        },
        "reason": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31,
          "position": 4
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "maxBytes": 1500,
          "position": 5
        },
        "status": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "position": 6
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "maxBytes": 600,
          "position": 7
        }
      },
      "indices": [
        {
          "name": "byBlog",
          "properties": [
            {
              "blogId": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true,
          "skipIfAbsent": true
        },
        {
          "name": "byPost",
          "properties": [
            {
              "blogPostId": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true,
          "skipIfAbsent": true
        },
        {
          "name": "byComment",
          "properties": [
            {
              "blogCommentId": "asc"
            },
            {
              "$ownerId": "asc"
            }
          ],
          "unique": true,
          "skipIfAbsent": true
        },
        {
          "name": "byStatus",
          "properties": [
            {
              "status": "asc"
            },
            {
              "$createdAt": "asc"
            }
          ]
        },
        {
          "name": "byModerator",
          "properties": [
            {
              "$moderatedBy": "asc"
            },
            {
              "$moderatedAt": "asc"
            }
          ]
        }
      ]
    },
    "restriction": {
      "type": "object",
      "documentsMutable": false,
      "canBeDeleted": false,
      "indices": [
        {
          "name": "byTarget",
          "properties": [
            {
              "target": "asc"
            }
          ],
          "unique": true
        },
        {
          "name": "standing",
          "properties": [
            {
              "target": "asc"
            },
            {
              "state": "asc"
            }
          ],
          "countable": "countable"
        },
        {
          "name": "log",
          "properties": [
            {
              "state": "asc"
            },
            {
              "$moderatedAt": "asc"
            }
          ]
        }
      ],
      "required": [
        "$createdAt",
        "target"
      ],
      "properties": {
        "target": {
          "type": "identifier",
          "position": 0,
          "refersTo": {
            "type": "identity"
          }
        },
        "state": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "position": 1
        },
        "reason": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63,
          "position": 2
        }
      },
      "moderatorAbilities": {
        "changeFields": [
          "state",
          "reason"
        ]
      },
      "propertyConstraints": {
        "moderatorsOnly": {
          "allOf": [
            {
              "present": "state"
            },
            {
              "present": "reason"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
