{
  "profile": {
    "type": "object",
    "description": "User profile with unified identity, avatar, payment addresses, and social links",
    "indices": [
      {
        "name": "owner",
        "unique": true,
        "properties": [
          {
            "$ownerId": "asc"
          }
        ]
      }
    ],
    "required": [
      "$createdAt",
      "$updatedAt",
      "displayName"
    ],
    "additionalProperties": false,
    "properties": {
      "displayName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "position": 0
      },
      "bio": {
        "type": "string",
        "maxLength": 160,
        "position": 1
      },
      "location": {
        "type": "string",
        "maxLength": 50,
        "position": 2
      },
      "website": {
        "type": "string",
        "maxLength": 200,
        "position": 3
      },
      "bannerUri": {
        "type": "string",
        "maxLength": 512,
        "position": 4
      },
      "avatar": {
        "type": "string",
        "maxLength": 512,
        "position": 5,
        "description": "DiceBear JSON {\"style\":\"bottts\",\"seed\":\"xyz\"} or image URI (https://, ipfs://)"
      },
      "paymentUris": {
        "type": "array",
        "maxItems": 16,
        "uniqueItems": true,
        "position": 6,
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "maxBytes": 512,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$"
        },
        "description": "Payment URIs such as dash:X... or bitcoin:bc1... (the client keeps an approved-scheme list): at most 16, no duplicates"
      },
      "pronouns": {
        "type": "string",
        "maxLength": 20,
        "position": 7
      },
      "nsfw": {
        "type": "boolean",
        "position": 8,
        "description": "Author-declared flag indicating profile may contain adult content"
      },
      "socialLinks": {
        "type": "array",
        "maxItems": 16,
        "uniqueItems": true,
        "position": 9,
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "maxBytes": 256,
          "pattern": "^[a-z]{1,16}:.+$"
        },
        "description": "Social links as \"<platform>:<handle>\" (twitter:@user, mastodon:@user@host): at most 16, no duplicates"
      }
    }
  }
}
